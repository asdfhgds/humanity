---
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryImage from '../components/StoryImage.astro';
import { eventPath } from '../lib/client-utils';

interface BriefItem {
  slug?: string;
  title: string;
  event_type?: string;
  country?: string;
  city?: string;
  date?: string;
  summary?: string;
  source_count?: number;
  confidence?: string;
}
interface DailyBrief {
  date?: string;
  generated_at?: string;
  items?: BriefItem[];
}

let brief: DailyBrief | null = null;
const briefsDirectory = resolve(process.cwd(), 'public', 'data', 'briefs');
try {
  const files = (await readdir(briefsDirectory))
    .filter((file) => /^\d{4}-\d{2}-\d{2}\.json$/.test(file))
    .sort()
    .reverse();
  if (files[0]) brief = JSON.parse(await readFile(join(briefsDirectory, files[0]), 'utf8'));
} catch (error) {
  if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) throw error;
}

const items = Array.isArray(brief?.items) ? brief.items : [];
---

<BaseLayout title="Daily Brief | HUMANITY" description="A source-linked daily selection of published event reports, with dates, locations and confidence context.">
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-10 grid items-center gap-6 border-b border-humanity-border pb-8 md:grid-cols-[1fr_22rem]">
      <div>
        <p class="eyebrow">Editorial briefing · scored from eligible published records</p>
        <h1 class="editorial-title mt-3 text-4xl font-bold sm:text-5xl">Daily brief</h1>
        {brief ? <p class="mt-3 text-sm text-humanity-textMuted">Generated {brief.generated_at ? new Date(brief.generated_at).toLocaleString() : brief.date || 'date unavailable'}. Event dates below refer to when events occurred, not when reports were published.</p> : <p class="mt-3 text-humanity-textMuted">Brief data is not available in this publication yet.</p>}
      </div>
      <StoryImage image="diplomacy" />
    </header>

    {brief ? items.length > 0 ? (
      <div class="divide-y divide-humanity-border">
        {items.map((item) => {
          const href = eventPath(item.slug);
          return (
            <article class="grid gap-3 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-humanity-accent">{(item.event_type || 'Event').replaceAll('_', ' ')}</p>
                <p class="mt-2 text-sm text-humanity-textMuted">{[item.city, item.country].filter(Boolean).join(', ') || 'Location not specified'}</p>
                <p class="mt-1 text-xs text-humanity-textMuted">Event date: {item.date || 'Not specified'}</p>
              </div>
              <div>
                <h2 class="editorial-title text-2xl font-semibold">{item.title}</h2>
                <p class="mt-2 leading-relaxed text-humanity-textMuted">{item.summary || 'No summary is available in this brief.'}</p>
                <p class="mt-3 text-xs text-humanity-textMuted">{item.confidence || 'Reported'} · {item.source_count ?? 0} linked sources</p>
                {href && <a href={href} class="link mt-3 inline-block">Open event record →</a>}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <section class="border-y border-humanity-border py-12">
        <h2 class="editorial-title text-2xl font-semibold">No eligible events are currently available.</h2>
        <p class="mt-2 text-humanity-textMuted">The latest brief was generated, but its evidence and publication rules yielded no events for inclusion.</p>
      </section>
    ) : (
      <section class="border-y border-humanity-border py-12">
        <h2 class="editorial-title text-2xl font-semibold">The daily brief is temporarily unavailable.</h2>
        <p class="mt-2 text-humanity-textMuted">A recent published brief could not be found. Please try again after the next data publication.</p>
      </section>
    )}
    <nav class="mt-8 flex gap-5 text-sm" aria-label="Brief navigation"><a class="link" href="/events">Browse all events</a><a class="link" href="/methodology">How evidence is assessed</a></nav>
  </main>
</BaseLayout>
