---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryImage from '../components/StoryImage.astro';
---

<BaseLayout title="Protests | HUMANITY" description="Global protests and demonstrations. Track political, social, economic, and environmental protests worldwide.">
  <div class="min-h-screen">
    <header class="border-b border-humanity-border bg-humanity-darker/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3">
              <svg class="w-8 h-8 text-humanity-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span class="text-2xl font-bold tracking-tight text-humanity-text">HUMANITY</span>
            </a>
            <span class="text-humanity-textMuted">/</span>
            <span class="text-humanity-text">Protests</span>
          </div>
          <nav class="hidden md:flex items-center gap-6">
            <a href="/" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Home</a>
            <a href="/map" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Map</a>
            <a href="/events" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Live Events</a>
            <a href="/protests" class="text-humanity-accent font-medium text-sm">Protests</a>
            <a href="/conflicts" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Conflicts</a>
            <a href="/human-cost" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Human Cost</a>
            <a href="/countries" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Countries</a>
            <a href="/timelines" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Timelines</a>
            <a href="/methodology" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Methodology</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8 grid items-center gap-6 border-b border-humanity-border pb-8 sm:grid-cols-[1fr_22rem]">
        <div><p class="eyebrow">Civic action and public assembly</p><h1 class="editorial-title mt-2 text-4xl font-bold">Protests & demonstrations</h1><p class="mt-3 text-humanity-textMuted">Browse published reports of rallies, strikes and civil disobedience. Coverage is source-dependent and incomplete.</p></div>
        <StoryImage image="protest" />
      </div>
      <div class="mb-8">
        <p id="protests-refresh-status" class="mt-2 text-xs text-humanity-textMuted" aria-live="polite">Checking for new reports…</p>
      </div>

      <!-- Filters -->
      <div class="mb-8 border-y border-humanity-border py-5">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-sm text-humanity-textMuted mb-1">Search protests</label>
            <input type="text" id="search-input" placeholder="Search by location, cause, demand..." class="input" />
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Country</label>
            <select id="country-filter" class="input">
              <option value="">All Countries</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Issue</label>
            <select id="issue-filter" class="input">
              <option value="">All Issues</option>
              <option value="political">Political</option>
              <option value="economic">Economic</option>
              <option value="social">Social</option>
              <option value="environmental">Environmental</option>
              <option value="human_rights">Human Rights</option>
              <option value="anti_government">Anti-Government</option>
              <option value="pro_government">Pro-Government</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Date</label>
            <select id="date-filter" class="input">
              <option value="">All Time</option>
              <option value="1">Last 24 hours</option>
              <option value="7">Last 7 days</option>
              <option value="30">Last 30 days</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Protests List -->
      <div id="protests-container" class="divide-y divide-humanity-border">
        <div class="card text-center py-12">
          <div class="animate-pulse-soft text-humanity-textMuted">Loading protests...</div>
        </div>
      </div>

      <div id="pagination" class="flex items-center justify-center gap-2 mt-8"></div>
    </main>
  </div>

<script>
  import { escapeHtml, eventPath, parsePublishedEvents, requireElement, sitePath, type PublishedEvent } from '../lib/client-utils';

  let allProtests: PublishedEvent[] = [];
  let currentPage = 1;
  const pageSize = 20;

  document.addEventListener('DOMContentLoaded', async () => {
    await loadProtests();
    setupFilters();
    window.setInterval(loadProtests, 60_000);
  });

  async function loadProtests() {
    const container = requireElement('protests-container', 'div');
    try {
      const response = await fetch(`${sitePath('data/events/type/PROTEST.json')}?updated=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Protests feed request failed (${response.status})`);
      allProtests = parsePublishedEvents(await response.json());
      populateCountryFilter();
      renderProtests();
      requireElement('protests-refresh-status', 'p').textContent =
        `Checked ${new Date().toLocaleTimeString()} · refreshes every minute`;
    } catch (error) {
      console.error('Could not refresh published protests:', error);
      requireElement('protests-refresh-status', 'p').textContent =
        allProtests.length ? 'Could not refresh; showing the latest available reports.' : 'Live protest reports are temporarily unavailable.';
      if (!allProtests.length) {
        container.innerHTML = '<div class="card p-8 text-center text-humanity-textMuted">The protests feed is temporarily unavailable. Please try again shortly.</div>';
      }
    }
  }

  function populateCountryFilter() {
    const select = requireElement('country-filter', 'select');
    const selectedCountry = select.value;
    select.length = 1;
    const countries = [...new Set(allProtests.map(e => e.country_name).filter((country): country is string => Boolean(country)))].sort();
    countries.forEach(country => {
      const option = document.createElement('option');
      option.value = country;
      option.textContent = country;
      select.appendChild(option);
    });
    select.value = selectedCountry;
  }

  function setupFilters() {
    ['search-input', 'country-filter', 'issue-filter', 'date-filter'].forEach(id => {
      requireElement(id, id === 'search-input' ? 'input' : 'select').addEventListener('input', () => {
        currentPage = 1;
        renderProtests();
      });
    });
    requireElement('pagination', 'div').addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('button[data-page]');
      if (button && !button.disabled) changePage(Number(button.dataset.page));
    });
  }

  function getFilteredProtests() {
    const search = requireElement('search-input', 'input').value.toLowerCase();
    const country = requireElement('country-filter', 'select').value;
    const issue = requireElement('issue-filter', 'select').value;
    const dateRange = requireElement('date-filter', 'select').value;

    return allProtests.filter(event => {
      if (search && !String(event.title || '').toLowerCase().includes(search) &&
          !String(event.city || '').toLowerCase().includes(search) &&
          !String(event.country_name || '').toLowerCase().includes(search)) {
        return false;
      }
      if (country && event.country_name !== country) return false;
      if (issue && event.issue !== issue) return false;
      if (dateRange) {
        const eventDate = new Date(event.start_time);
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - parseInt(dateRange));
        if (eventDate < cutoff) return false;
      }
      return true;
    }).sort((a, b) => new Date(b.start_time).getTime() - new Date(a.start_time).getTime());
  }

  function renderProtests() {
    const container = requireElement('protests-container', 'div');
    const pagination = requireElement('pagination', 'div');
    const filtered = getFilteredProtests();
    
    const totalPages = Math.ceil(filtered.length / pageSize);
    currentPage = totalPages ? Math.min(currentPage, totalPages) : 1;
    const start = (currentPage - 1) * pageSize;
    const pageEvents = filtered.slice(start, start + pageSize);

    if (pageEvents.length === 0) {
      container.innerHTML = `<div class="card text-center py-12"><h3 class="text-lg font-medium text-humanity-text mb-2">No protests found</h3><p class="text-humanity-textMuted">Try adjusting your filters.</p></div>`;
      pagination.innerHTML = '';
      return;
    }

    container.innerHTML = pageEvents.map(event => {
      const href = eventPath(event.slug);
      const title = href ? `<a href="${href}" class="link hover:text-blue-400">${escapeHtml(event.title)}</a>` : escapeHtml(event.title);
      return `
      <article class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-humanity-accent">Protest · ${escapeHtml(event.confidence || 'Reported')}</p>
          <p class="mt-2 text-sm text-humanity-textMuted">${escapeHtml(formatDate(event.start_time))}</p>
          <p class="mt-1 text-sm text-humanity-textMuted">${escapeHtml([event.city, event.country_name].filter(Boolean).join(', ') || 'Location unknown')}</p>
        </div>
        <div class="min-w-0">
          <h3 class="editorial-title text-xl font-semibold leading-snug">${title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-humanity-textMuted">${escapeHtml(event.summary || 'No summary available.')}</p>
          <p class="mt-3 text-xs text-humanity-textMuted">${Number.isSafeInteger(event.sources?.length) ? event.sources?.length : 0} linked sources${event.issue ? ` · ${escapeHtml(String(event.issue).replace('_', ' '))}` : ''}</p>
          ${renderHumanImpact(event)}
        </div>
      </article>
    `;
    }).join('');

    if (totalPages > 1) {
      pagination.innerHTML = `
        <button data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} class="btn-secondary">Previous</button>
        <span class="px-4 text-humanity-textMuted">Page ${currentPage} of ${totalPages}</span>
        <button data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''} class="btn-secondary">Next</button>
      `;
    } else {
      pagination.innerHTML = '';
    }
  }

  function changePage(page: number) {
    currentPage = page;
    renderProtests();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderHumanImpact(event: PublishedEvent) {
    const impacts = event.human_impact || {};
    const parts = [];
    if (impacts.participants) parts.push(`<span>Participants reported: ${escapeHtml(impacts.participants)}</span>`);
    if (impacts.injuries) parts.push(`<span>Injuries reported: ${escapeHtml(impacts.injuries)}</span>`);
    if (impacts.arrests) parts.push(`<span>Arrests reported: ${escapeHtml(impacts.arrests)}</span>`);
    if (impacts.deaths) parts.push(`<span>Deaths reported: ${escapeHtml(impacts.deaths)}</span>`);
    if (parts.length === 0) return '';
    return `<div class="flex flex-wrap gap-3 mt-2">${parts.join('')}</div>`;
  }

  function formatDate(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

</script>
</BaseLayout>