---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryImage from '../components/StoryImage.astro';
---

<BaseLayout title="Timelines | HUMANITY" description="Chronological timelines of human events by country, conflict, and topic. Filter by event type, severity, and date range.">
  <div class="min-h-screen">
    <header class="border-b border-humanity-border bg-humanity-darker/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3">
              <svg class="w-8 h-8 text-humanity-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span class="text-2xl font-bold tracking-tight text-humanity-text">HUMANITY</span>
            </a>
            <span class="text-humanity-textMuted">/</span>
            <span class="text-humanity-text">Timelines</span>
          </div>
          <nav class="hidden md:flex items-center gap-6">
            <a href="/" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Home</a>
            <a href="/map" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Map</a>
            <a href="/events" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Live Events</a>
            <a href="/protests" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Protests</a>
            <a href="/conflicts" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Conflicts</a>
            <a href="/human-cost" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Human Cost</a>
            <a href="/countries" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Countries</a>
            <a href="/timelines" class="text-humanity-accent font-medium text-sm">Timelines</a>
            <a href="/methodology" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Methodology</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8 grid items-center gap-6 border-b border-humanity-border pb-8 sm:grid-cols-[1fr_22rem]">
        <div><p class="eyebrow">Chronology and change</p><h1 class="editorial-title mt-2 text-4xl font-semibold">Timelines</h1>
        <p class="mt-3 text-humanity-textMuted">Follow published event records by place, type and date. Filters narrow the monitored record; they do not represent a complete history.</p>
        <p id="timeline-refresh-status" class="mt-2 text-xs text-humanity-textMuted" aria-live="polite">Checking the event feed…</p></div>
        <StoryImage image="conflict" />
      </div>

      <!-- Timeline Selector -->
      <div class="card mb-8">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-sm text-humanity-textMuted mb-1">Select Timeline</label>
            <select id="timeline-select" class="input">
              <option value="global">Global Timeline</option>
              <option value="ukraine">Ukraine Conflict</option>
              <option value="gaza">Gaza Conflict</option>
              <option value="sudan">Sudan Conflict</option>
              <option value="myanmar">Myanmar Conflict</option>
              <option value="syria">Syria Conflict</option>
              <option value="france">France Protests</option>
              <option value="iran">Iran Protests</option>
              <option value="afghanistan">Afghanistan</option>
              <option value="drc">DR Congo</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Event Type</label>
            <select id="type-filter" class="input">
              <option value="">All Types</option>
              <option value="PROTEST">Protest</option>
              <option value="CONFLICT">Conflict</option>
              <option value="ATTACK">Attack</option>
              <option value="CASUALTY">Casualty</option>
              <option value="DISPLACEMENT">Displacement</option>
              <option value="DISASTER">Disaster</option>
              <option value="REPRESSION">Repression</option>
              <option value="HUMANITARIAN">Humanitarian</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Year</label>
            <select id="year-filter" class="input">
              <option value="">All Years</option>
              <option value="2026">2026</option>
              <option value="2025">2025</option>
              <option value="2024">2024</option>
              <option value="2023">2023</option>
              <option value="2022">2022</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Severity</label>
            <select id="severity-filter" class="input">
              <option value="">All</option>
              <option value="8">8+ (Extreme)</option>
              <option value="6">6+ (Severe)</option>
              <option value="4">4+ (Significant)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Timeline View -->
      <div id="timeline-container">
        <div class="card">
          <div class="overflow-x-auto">
            <table class="w-full" id="timeline-table">
              <thead>
                <tr class="border-b border-humanity-border text-left text-sm text-humanity-textMuted">
                  <th class="p-4 font-medium text-humanity-text w-32">Date</th>
                  <th class="p-4 font-medium text-humanity-text">Event</th>
                  <th class="p-4 font-medium text-humanity-text w-24">Type</th>
                  <th class="p-4 font-medium text-humanity-text w-20">Severity</th>
                  <th class="p-4 font-medium text-humanity-text w-32">Location</th>
                  <th class="p-4 font-medium text-humanity-text w-28">Impact</th>
                </tr>
              </thead>
              <tbody id="timeline-body" class="divide-y divide-humanity-border/50">
                <tr><td colspan="6" class="p-8 text-center text-humanity-textMuted">Loading timeline...</td></tr>
              </tbody>
            </table>
          </div>
          <div id="timeline-pagination" class="flex items-center justify-center gap-2 mt-6"></div>
        </div>
      </div>

      <!-- Visual Timeline (alternative view) -->
      <div id="visual-timeline" class="mt-8 hidden">
        <h2 class="text-xl font-semibold text-humanity-text mb-4">Visual Timeline</h2>
        <div class="card p-6" id="visual-timeline-content">
          <p class="text-humanity-textMuted text-center py-8">Select a timeline to view visual representation</p>
        </div>
      </div>
    </main>
  </div>

<script>
  import { escapeHtml, eventPath, parsePublishedEvents, requireElement, sitePath, type PublishedEvent } from '../lib/client-utils';

  let currentTimeline = 'global';
  interface TimelineEvent extends PublishedEvent {
    date: string;
    type: string;
    location: string;
    deaths?: unknown;
    injuries?: unknown;
    displaced?: unknown;
  }
  let allEvents: TimelineEvent[] = [];
  let currentPage = 1;
  const pageSize = 50;

  document.addEventListener('DOMContentLoaded', async () => {
    await loadTimeline('global');
    setupFilters();
    window.setInterval(() => loadTimeline(currentTimeline), 60_000);
  });

  function setupFilters() {
    requireElement('timeline-select', 'select').addEventListener('change', (event) => {
      if (!(event.currentTarget instanceof HTMLSelectElement)) return;
      currentTimeline = event.currentTarget.value;
      currentPage = 1;
      loadTimeline(currentTimeline);
    });
    ['type-filter', 'year-filter', 'severity-filter'].forEach(id => {
      requireElement(id, 'select').addEventListener('change', () => {
        currentPage = 1;
        renderTimeline();
      });
    });
    requireElement('timeline-pagination', 'div').addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('button[data-page]');
      if (button && !button.disabled) changePage(Number(button.dataset.page));
    });
  }

  async function loadTimeline(timelineId: string) {
    const tbody = requireElement('timeline-body', 'tbody');
    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-humanity-textMuted">Loading timeline...</td></tr>';
    
    try {
      const response = await fetch(`${sitePath('data/events/all.json')}?updated=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Timeline feed request failed (${response.status})`);
      const events = parsePublishedEvents(await response.json());
      const countryCodes: Record<string, string> = {
        ukraine: 'UA', gaza: 'PS', sudan: 'SD', myanmar: 'MM', syria: 'SY',
        france: 'FR', iran: 'IR', afghanistan: 'AF', drc: 'CD',
      };
      const countryCode = countryCodes[timelineId];
      allEvents = events
        .filter(event => !countryCode || event.country_code === countryCode)
        .map(event => ({
          ...event,
          date: event.start_time?.slice(0, 10) || '',
          type: event.event_type,
          location: [event.city, event.country_name].filter(Boolean).join(', ') || 'Location unconfirmed',
          deaths: event.human_impact?.deaths,
          injuries: event.human_impact?.injuries,
          displaced: event.human_impact?.displaced,
        }));
      renderTimeline();
      requireElement('timeline-refresh-status', 'p').textContent =
        `Checked ${new Date().toLocaleTimeString()} · refreshes every minute`;
    } catch (error) {
      console.error('Could not refresh published timeline:', error);
      requireElement('timeline-refresh-status', 'p').textContent =
        allEvents.length ? 'Could not refresh; showing the latest available reports.' : 'Timeline data is temporarily unavailable.';
      if (!allEvents.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-humanity-textMuted">The timeline feed is temporarily unavailable.</td></tr>';
      }
    }
  }

  function getFilteredEvents() {
    const type = requireElement('type-filter', 'select').value;
    const year = requireElement('year-filter', 'select').value;
    const severity = requireElement('severity-filter', 'select').value;

    return allEvents.filter(event => {
      if (type && event.type !== type) return false;
      if (year && !event.date.startsWith(year)) return false;
      if (severity && (event.severity ?? 0) < parseInt(severity)) return false;
      return true;
    }).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
  }

  function renderTimeline() {
    const tbody = requireElement('timeline-body', 'tbody');
    const pagination = requireElement('timeline-pagination', 'div');
    const filtered = getFilteredEvents();
    
    const totalPages = Math.ceil(filtered.length / pageSize);
    currentPage = totalPages ? Math.min(currentPage, totalPages) : 1;
    const start = (currentPage - 1) * pageSize;
    const pageEvents = filtered.slice(start, start + pageSize);

    if (pageEvents.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-humanity-textMuted">No events match your filters</td></tr>';
      pagination.innerHTML = '';
      return;
    }

    tbody.innerHTML = pageEvents.map(event => {
      const eventUrl = eventPath(event.slug);
      const eventType = String(event.type || 'EVENT');
      const eventTypeClass = escapeHtml(eventType.toLowerCase());
      const eventTitle = escapeHtml(event.title);
      return `
        <tr class="hover:bg-humanity-card/50">
          <td class="p-4 text-humanity-textMuted font-mono">${escapeHtml(formatDate(event.date))}</td>
          <td class="p-4">
            ${eventUrl
              ? `<a href="${eventUrl}" class="link hover:text-humanity-accent font-medium">${eventTitle}</a>`
              : `<span class="font-medium">${eventTitle}</span>`}
          </td>
          <td class="p-4"><span class="badge-${eventTypeClass}">${escapeHtml(getTypeLabel(eventType))}</span></td>
          <td class="p-4">
            <span class="px-2 py-1 rounded text-xs font-medium" style="background: ${getSeverityColor(event.severity)}20; color: ${getSeverityColor(event.severity)}; border: 1px solid ${getSeverityColor(event.severity)}40;">
              ${Number.isFinite(event.severity) ? event.severity : '—'}/10
            </span>
          </td>
          <td class="p-4 text-humanity-textMuted">${escapeHtml(event.location)}</td>
          <td class="p-4 text-sm">
            ${renderImpact(event)}
          </td>
        </tr>
      `;
    }).join('');

    if (totalPages > 1) {
      pagination.innerHTML = `
        <button data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} class="btn-secondary text-sm">Previous</button>
        <span class="px-4 text-humanity-textMuted text-sm">Page ${currentPage} of ${totalPages} (${filtered.length} events)</span>
        <button data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''} class="btn-secondary text-sm">Next</button>
      `;
    } else {
      pagination.innerHTML = '';
    }
  }

  function changePage(page: number) {
    currentPage = page;
    renderTimeline();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderImpact(event: TimelineEvent) {
    const parts = [];
    if (event.deaths) parts.push(`<span class="text-red-400">☠ ${escapeHtml(event.deaths)}</span>`);
    if (event.injuries) parts.push(`<span class="text-orange-400">🤕 ${escapeHtml(event.injuries)}</span>`);
    if (event.displaced) parts.push(`<span class="text-amber-400">🏃 ${escapeHtml(event.displaced)}</span>`);
    return parts.join(' ') || '<span class="text-humanity-textMuted">—</span>';
  }

  function getTypeLabel(type: string) {
    const labels: Record<string, string> = { PROTEST: 'Protest', CONFLICT: 'Conflict', ATTACK: 'Attack', CASUALTY: 'Casualty', DISPLACEMENT: 'Displacement', DISASTER: 'Disaster', REPRESSION: 'Repression', HUMANITARIAN: 'Humanitarian' };
    return labels[type] || String(type || 'Event');
  }

  function getSeverityColor(severity: number | undefined) {
    const value = severity ?? 0;
    if (value >= 8) return '#ef4444';
    if (value >= 6) return '#f97316';
    if (value >= 4) return '#f97316';
    return '#3b82f6';
  }

  function formatDate(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

</script>
</BaseLayout>
