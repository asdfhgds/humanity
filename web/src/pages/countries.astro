---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryImage from '../components/StoryImage.astro';
---

<BaseLayout title="Countries | HUMANITY" description="Browse events by country. View protests, conflicts, humanitarian events, and human impact for every nation.">
  <div class="min-h-screen">
    <header class="border-b border-humanity-border bg-humanity-darker/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3">
              <svg class="w-8 h-8 text-humanity-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span class="text-2xl font-bold tracking-tight text-humanity-text">HUMANITY</span>
            </a>
            <span class="text-humanity-textMuted">/</span>
            <span class="text-humanity-text">Countries</span>
          </div>
          <button id="countries-retry" type="button" class="btn-secondary mt-5 hidden">Retry loading countries</button>
          <nav class="hidden md:flex items-center gap-6">
            <a href="/" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Home</a>
            <a href="/map" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Map</a>
            <a href="/events" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Live Events</a>
            <a href="/protests" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Protests</a>
            <a href="/conflicts" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Conflicts</a>
            <a href="/human-cost" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Human Cost</a>
            <a href="/countries" class="text-humanity-accent font-medium text-sm">Countries</a>
            <a href="/timelines" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Timelines</a>
            <a href="/methodology" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Methodology</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <div class="grid items-center gap-6 border-b border-humanity-border pb-8 sm:grid-cols-[1fr_22rem]">
          <div><p class="eyebrow">Places and people</p><h1 class="editorial-title mt-2 text-4xl font-bold">Countries</h1><p class="mt-3 text-humanity-textMuted">Browse places represented in the published event database.</p></div>
          <StoryImage image="geography" />
        </div>
      </div>

      <!-- Search -->
      <div class="card mb-8">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex-1 min-w-[300px]">
            <label class="block text-sm text-humanity-textMuted mb-1">Search countries</label>
            <input type="text" id="search-input" placeholder="Type country name..." class="input" />
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Region</label>
            <select id="region-filter" class="input">
              <option value="">All Regions</option>
              <option value="Africa">Africa</option>
              <option value="Americas">Americas</option>
              <option value="Asia">Asia</option>
              <option value="Europe">Europe</option>
              <option value="Oceania">Oceania</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Sort by</label>
            <select id="sort-filter" class="input">
              <option value="events">Most published events</option>
              <option value="name">Alphabetical</option>
              <option value="recent">Most Recent</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Countries Grid -->
      <div id="countries-grid" class="country-index grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6">
        <div class="card text-center py-12 col-span-full">
          <div class="animate-pulse-soft text-humanity-textMuted">Loading countries...</div>
        </div>
      </div>
    </main>
  </div>

<script>
  import { escapeHtml, requireElement, sitePath } from '../lib/client-utils';

  interface CountryRecord {
    name: string;
    code: string;
    region?: string;
    events?: number;
    protests?: number;
    conflicts?: number;
    recent?: string;
  }

  function isCountryRecord(value: unknown): value is CountryRecord {
    if (!value || typeof value !== 'object') return false;
    const record = value as Record<string, unknown>;
    return typeof record.name === 'string' &&
      typeof record.code === 'string' &&
      (record.region === undefined || typeof record.region === 'string') &&
      (record.events === undefined || typeof record.events === 'number') &&
      (record.protests === undefined || typeof record.protests === 'number') &&
      (record.conflicts === undefined || typeof record.conflicts === 'number') &&
      (record.recent === undefined || typeof record.recent === 'string');
  }

  let allCountries: CountryRecord[] = [];

  document.addEventListener('DOMContentLoaded', async () => {
    await loadCountries();
    setupFilters();
    requireElement('countries-retry', 'button').addEventListener('click', loadCountries);
  });

  async function loadCountries() {
    const grid = requireElement('countries-grid', 'div');
    const retry = requireElement('countries-retry', 'button');
    retry.classList.add('hidden');
    try {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 10_000);
      let response;
      try {
        response = await fetch(sitePath('data/countries/all.json'), { signal: controller.signal, cache: 'no-store' });
      } finally {
        window.clearTimeout(timeout);
      }
      if (!response.ok) throw new Error(`Country feed request failed (${response.status})`);
      const countries: unknown = await response.json();
      if (!Array.isArray(countries) || countries.some((country: unknown) => !isCountryRecord(country))) {
        throw new Error('Country feed has an invalid format');
      }
      allCountries = countries as CountryRecord[];
      renderCountries();
    } catch (error) {
      console.error('Could not load published country data:', error);
      grid.innerHTML = '<div class="col-span-full border-y border-humanity-border py-12 text-center"><h2 class="font-semibold text-humanity-text">Country data is unavailable</h2><p class="mt-2 text-sm text-humanity-textMuted">We could not load the published country feed. Please try again later.</p></div>';
      retry.classList.remove('hidden');
    }
  }

  function setupFilters() {
    ['search-input', 'region-filter', 'sort-filter'].forEach(id => {
      requireElement(id, id === 'search-input' ? 'input' : 'select').addEventListener('input', renderCountries);
    });
  }

  function getFilteredCountries() {
    const search = requireElement('search-input', 'input').value.toLowerCase();
    const region = requireElement('region-filter', 'select').value;
    const sort = requireElement('sort-filter', 'select').value;

    let filtered = allCountries.filter(c => {
      if (search && !c.name.toLowerCase().includes(search)) return false;
      if (region && c.region !== region) return false;
      return true;
    });

    switch (sort) {
      case 'name':
        filtered.sort((a, b) => a.name.localeCompare(b.name));
        break;
      case 'recent':
        filtered.sort((a, b) => new Date(b.recent || 0).getTime() - new Date(a.recent || 0).getTime());
        break;
      default:
        filtered.sort((a, b) => (b.events || 0) - (a.events || 0));
    }

    return filtered;
  }

  function renderCountries() {
    const grid = requireElement('countries-grid', 'div');
    const filtered = getFilteredCountries();

    if (filtered.length === 0) {
      grid.innerHTML = '<div class="col-span-full border-y border-humanity-border py-12 text-center"><h3 class="text-lg font-medium text-humanity-text mb-2">No countries found</h3><p class="text-humanity-textMuted">Try adjusting your filters.</p></div>';
      return;
    }

    grid.innerHTML = filtered.map(c => `
      <article class="country-entry border-t border-humanity-border py-5">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <span class="rounded border border-humanity-border px-2 py-1 font-mono text-xs text-humanity-textMuted">${escapeHtml(c.code)}</span>
            <div>
              <h3 class="font-semibold text-humanity-text">${escapeHtml(c.name)}</h3>
              <p class="text-xs text-humanity-textMuted">${escapeHtml(c.region || 'Region unspecified')}</p>
            </div>
          </div>
          ${(c.conflicts ?? 0) > 0 ? '<span class="badge bg-red-500/20 text-red-400 border border-red-500/30">Conflict records</span>' : ''}
        </div>
        
        <div class="grid grid-cols-2 gap-3 mb-3 border-y border-humanity-border py-3">
        <div class="text-left">
          <div class="text-lg font-bold text-humanity-accent">${typeof c.events === 'number' && Number.isSafeInteger(c.events) ? c.events.toLocaleString() : '—'}</div>
            <div class="text-xs text-humanity-textMuted">Published events</div>
          </div>
        <div class="text-left">
          <div class="text-lg font-bold text-humanity-accent">${typeof c.protests === 'number' && Number.isSafeInteger(c.protests) ? c.protests.toLocaleString() : '—'}</div>
            <div class="text-xs text-humanity-textMuted">Protests</div>
          </div>
        </div>

        <div class="text-xs text-humanity-textMuted">
          Latest event date in feed: ${escapeHtml(formatDate(c.recent))}
        </div>
      </article>
    `).join('');
  }

  function formatDate(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
</script>

<style>
  .country-index { border-bottom: 1px solid #d7d0c5; }
  .country-entry { min-width: 0; }
  @media (min-width: 640px) { .country-entry:nth-child(2) { border-top: 1px solid #d7d0c5; } }
</style>
</BaseLayout>