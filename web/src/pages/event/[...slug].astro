---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

export async function getStaticPaths() {
  const indexPath = resolve(process.cwd(), 'public', 'data', 'events', 'all.json');
  let publishedEvents;
  try {
    publishedEvents = JSON.parse(await readFile(indexPath, 'utf8'));
  } catch (error) {
    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') return [];
    throw error;
  }
  if (!Array.isArray(publishedEvents)) throw new Error('The published events index must contain an array');

  return publishedEvents
    .filter((event) =>
      event &&
      typeof event.slug === 'string' &&
      event.slug.length > 0 &&
      (event.publication_status === 'published' || event.publication_status === 'published_with_warning'),
    )
    .map((event) => ({ params: { slug: event.slug } }));
}

const { slug } = Astro.params;
const slugStr = Array.isArray(slug) ? slug.join('/') : slug;
---

<BaseLayout title="Event Details | HUMANITY" description="Detailed view of a human event with sources, evidence, and verification status.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-humanity-textMuted" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="link hover:text-humanity-text">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/events" class="link hover:text-humanity-text">Events</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-humanity-text">{slugStr}</li>
      </ol>
    </nav>

    <div id="event-container" class="animate-fade-in">
      <!-- Loading state -->
      <div class="card text-center py-12">
        <div class="animate-pulse-soft text-humanity-textMuted">Loading event data...</div>
      </div>
    </div>
  </div>

<script>
  import { escapeHtml, eventPath, parsePublishedEvent, parsePublishedEvents, requireElement, safeExternalUrl, sitePath, type PublishedEvent, type PublishedClaim, type PublishedSource } from '../../lib/client-utils';

  document.addEventListener('DOMContentLoaded', async () => {
    const container = requireElement('event-container', 'div');
    
    try {
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const eventIndex = pathParts.lastIndexOf('event');
      const slugStr = pathParts.slice(eventIndex + 1).map(decodeURIComponent).join('/');
      // Convert slug back to file path
      const fileSlug = slugStr.replace(/\//g, '_');
      let response = await fetch(sitePath(`data/events/${fileSlug}.json`));
      let event: PublishedEvent;
      if (response.ok) {
        event = parsePublishedEvent(await response.json());
      } else {
        response = await fetch(sitePath('data/events/all.json'));
        if (!response.ok) throw new Error('Event data could not be loaded');
        const indexedEvents = parsePublishedEvents(await response.json());
        const matchedEvent = indexedEvents.find(item => item.slug === slugStr);
        if (!matchedEvent) throw new Error('Event not found');
        event = matchedEvent;
      }
      let allEvents: PublishedEvent[] = [];
      if (event.related_events?.length) {
        const eventsResponse = await fetch(sitePath('data/events/all.json'));
        if (!eventsResponse.ok) throw new Error('Related event index could not be loaded');
        allEvents = parsePublishedEvents(await eventsResponse.json());
      }
      renderEvent(event, allEvents);
      
      // Update page title
      document.title = `${event.title} | HUMANITY`;
      
      // Update meta description
      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc) {
        metaDesc.setAttribute('content', event.summary || event.description?.slice(0, 160) || 'Event details');
      }
      
    } catch (error) {
      console.error('Could not load published event record:', error);
      container.innerHTML = `
        <div class="card text-center py-12">
          <h2 class="text-xl font-semibold text-humanity-text mb-2">Event Not Found</h2>
          <p class="text-humanity-textMuted">The requested event could not be found or has not been published yet.</p>
          <a href="/events" class="btn-primary mt-4 inline-block">Browse All Events</a>
        </div>
      `;
    }
  });
  
  function renderEvent(event: PublishedEvent, allEvents: PublishedEvent[]) {
    const container = requireElement('event-container', 'div');
    
    const typeColors: Record<string, string> = {
      PROTEST: '#3b82f6',
      CONFLICT: '#ef4444',
      ATTACK: '#dc2626',
      CASUALTY: '#b91c1c',
      DISPLACEMENT: '#f97316',
      DISASTER: '#0ea5e9',
      REPRESSION: '#7c3aed',
      HUMANITARIAN: '#10b981'
    };
    
    const color = typeColors[event.event_type] || '#888888';
    const typeLabel = escapeHtml(String(event.event_type || 'Event').replaceAll('_', ' '));
    const confidence = String(event.confidence || 'LOW');
    const sourceCount = event.sources?.length ?? 0;
    
    container.innerHTML = `
      <article class="space-y-8">
        <!-- Header -->
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 rounded-full text-sm font-medium text-white" style="background: ${color};">${typeLabel}</span>
            <span class="px-3 py-1 rounded-full text-sm font-medium badge-confidence-${escapeHtml(confidence.toLowerCase())}">${escapeHtml(event.confidence || 'Reported')}</span>
            ${event.publish_warning ? '<span class="px-3 py-1 rounded-full text-sm font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30">⚠️ Developing Story</span>' : ''}
          </div>
          
          <h1 class="text-3xl sm:text-4xl font-bold text-humanity-text leading-tight">${escapeHtml(event.title)}</h1>
          
          <div class="flex flex-wrap items-center gap-4 text-sm text-humanity-textMuted border-t border-humanity-border pt-4">
            <span>📍 ${escapeHtml([event.city, event.country_name].filter(Boolean).join(', ') || 'Unknown location')}</span>
            <span>📅 ${escapeHtml(formatDate(event.start_time))}${event.end_time ? ` – ${escapeHtml(formatDate(event.end_time))}` : ''}</span>
            <span>📰 ${Number.isSafeInteger(sourceCount) ? sourceCount : 0} source${sourceCount !== 1 ? 's' : ''}</span>
            ${Number.isFinite(event.severity) ? `<span>Severity: ${event.severity}/10</span>` : ''}
          </div>
        </header>

        <!-- Map -->
        ${Number.isFinite(event.latitude) && Number.isFinite(event.longitude) ? `
        <section class="card p-0 overflow-hidden">
          <div id="event-map" class="map-container-sm"></div>
        </section>
        ` : ''}

        <!-- Key Facts -->
        ${renderHumanImpact(event)}

        <!-- Summary -->
        <section class="card">
          <h2 class="text-xl font-semibold text-humanity-text mb-4">Summary</h2>
          <div class="prose prose-invert max-w-none text-humanity-textMuted">
            <p>${escapeHtml(event.summary || event.description || 'No event summary is available.')}</p>
          </div>
        </section>

        <!-- What is Known -->
        ${renderSection('What Is Known', event.known, '✅', 'emerald')}

        <!-- What Is Uncertain -->
        ${renderSection('What Is Uncertain', event.uncertain, '❓', 'amber')}

        <!-- Sources -->
        ${renderSources(event.sources)}

        <!-- Claims/Evidence -->
        ${renderClaims(event.claims)}

        <!-- Related -->
        ${renderRelated(event, allEvents)}

        <!-- Metadata -->
        <footer class="border-t border-humanity-border pt-6 text-sm text-humanity-textMuted space-y-1">
          <p>First detected: ${escapeHtml(formatDateTime(event.first_detected_at))}</p>
          <p>Last updated: ${escapeHtml(formatDateTime(event.last_updated_at))}</p>
          ${event.published_at ? `<p>Published: ${escapeHtml(formatDateTime(event.published_at))}</p>` : ''}
          <p>Event ID: <code class="text-humanity-textMuted/70">${escapeHtml(event.id)}</code></p>
          ${event.canonical_id ? `<p>Canonical ID: <code class="text-humanity-textMuted/70">${escapeHtml(event.canonical_id)}</code></p>` : ''}
        </footer>
      </article>
    `;
    
    // Initialize map if coordinates exist
    if (Number.isFinite(event.latitude) && Number.isFinite(event.longitude)) {
      setTimeout(() => initEventMap(event), 100);
    }
  }
  
  function renderHumanImpact(event: PublishedEvent) {
    const impacts: Array<{ icon: string; label: string; value: unknown; color: string }> = [];
    if (event.human_impact) {
      if (event.human_impact.deaths) impacts.push({ icon: '☠️', label: 'Deaths', value: event.human_impact.deaths, color: '#ef4444' });
      if (event.human_impact.injuries) impacts.push({ icon: '🤕', label: 'Injuries', value: event.human_impact.injuries, color: '#f97316' });
      if (event.human_impact.arrests) impacts.push({ icon: '🚔', label: 'Arrests', value: event.human_impact.arrests, color: '#7c3aed' });
      if (event.human_impact.displaced) impacts.push({ icon: '🏃', label: 'Displaced', value: event.human_impact.displaced, color: '#f97316' });
      if (event.human_impact.participants) impacts.push({ icon: '✊', label: 'Participants', value: event.human_impact.participants, color: '#3b82f6' });
    }
    
    if (impacts.length === 0) return '';
    
    return `
      <section class="card">
        <h2 class="text-xl font-semibold text-humanity-text mb-4">Human Impact</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-${impacts.length} gap-4">
          ${impacts.map(i => `
            <div class="text-center p-4 rounded-lg" style="background: ${i.color}10; border: 1px solid ${i.color}30;">
              <div class="text-2xl mb-1">${i.icon}</div>
              <div class="text-2xl font-bold text-humanity-text" style="color: ${i.color};">${escapeHtml(i.value)}</div>
              <div class="text-xs text-humanity-textMuted">${escapeHtml(i.label)}</div>
            </div>
          `).join('')}
        </div>
      </section>
    `;
  }
  
  function renderSection(title: string, items: string[] | undefined, icon: string, color: string) {
    if (!items || items.length === 0) return '';
    return `
      <section class="card">
        <h2 class="text-xl font-semibold text-humanity-text mb-4 flex items-center gap-2">
          <span style="color: ${color};">${icon}</span>
          ${title}
        </h2>
        <ul class="space-y-2 text-sm text-humanity-textMuted">
          ${items.map(item => `<li class="flex items-start gap-2"><span class="text-${color}-400 mt-0.5">${icon}</span><span>${escapeHtml(item)}</span></li>`).join('')}
        </ul>
      </section>
    `;
  }
  
  function renderSources(sources: PublishedSource[] | undefined) {
    if (!sources || sources.length === 0) return '';
    return `
      <section class="card">
        <h2 class="text-xl font-semibold text-humanity-text mb-4 flex items-center gap-2">
          <span>📰</span>
          Sources (${sources.length})
        </h2>
        <ul class="space-y-3">
          ${sources.map(s => {
            const url = safeExternalUrl(s.url);
            const title = escapeHtml(s.title);
            return `
            <li class="p-3 rounded-lg border border-humanity-border hover:border-humanity-accent/50 transition-colors">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  ${url ? `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="link font-medium text-humanity-text hover:text-humanity-accent">${title}</a>` : `<span class="font-medium text-humanity-text">${title}</span>`}
                  <div class="flex items-center gap-3 mt-1 text-xs text-humanity-textMuted">
                    <span>${escapeHtml(s.publisher)}</span>
                    <span>${escapeHtml(s.source_type)}</span>
                    ${s.published_at ? `<span>${escapeHtml(formatDate(s.published_at))}</span>` : ''}
                    ${s.country ? `<span>📍 ${escapeHtml(s.country)}</span>` : ''}
                    ${s.language ? `<span>${escapeHtml(String(s.language).toUpperCase())}</span>` : ''}
                  </div>
                </div>
              </div>
            </li>
          `;
          }).join('')}
        </ul>
      </section>
    `;
  }
  
  function renderClaims(claims: Record<string, PublishedClaim[]> | undefined) {
    if (!claims || Object.keys(claims).length === 0) return '';
    
    return `
      <section class="card">
        <h2 class="text-xl font-semibold text-humanity-text mb-4 flex items-center gap-2">
          <span>📋</span>
          Evidence & Claims
        </h2>
        <div class="space-y-4">
          ${Object.entries(claims).map(([type, claimList]) => `
            <div>
              <h3 class="font-medium text-humanity-text mb-2 capitalize">${escapeHtml(type.replace('_', ' '))}</h3>
              <div class="space-y-2">
                ${claimList.map(claim => `
                  <div class="p-3 rounded-lg border border-humanity-border bg-humanity-darker/50">
                    <div class="flex items-start justify-between gap-2">
                      <div class="flex-1">
                        <p class="text-sm text-humanity-text">${escapeHtml(claim.subject)} ${escapeHtml(claim.predicate)}: <strong>${escapeHtml(claim.min_value !== undefined || claim.max_value !== undefined ? formatRange(claim.min_value, claim.max_value) + (claim.unit ? ' ' + claim.unit : '') : `${claim.value ?? 'Not reported'}${claim.unit ? ' ' + claim.unit : ''}`)}</strong></p>
                        <p class="text-xs text-humanity-textMuted mt-1">"${escapeHtml(String(claim.source_quote || '').slice(0, 200))}${String(claim.source_quote || '').length > 200 ? '...' : ''}"</p>
                      </div>
                      <div class="flex items-center gap-2 text-xs">
                        <span class="badge-confidence-${Math.round((claim.confidence ?? 0) * 100) > 70 ? 'high' : Math.round((claim.confidence ?? 0) * 100) > 40 ? 'medium' : 'low'}">${Math.round((claim.confidence ?? 0) * 100)}%</span>
                        <span class="text-humanity-textMuted">${escapeHtml(String(claim.verification_status || 'status unavailable').replace('_', ' '))}</span>
                      </div>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `).join('')}
        </div>
      </section>
    `;
  }
  
  function renderRelated(event: PublishedEvent, allEvents: PublishedEvent[]) {
    const parts = [];
    if (event.related_events && event.related_events.length > 0) {
      parts.push(`
        <section class="card">
          <h2 class="text-xl font-semibold text-humanity-text mb-4">Related Events</h2>
          <ul class="space-y-2">
            ${event.related_events.map(id => {
              const relatedEvent = allEvents.find(item => item.id === id);
              const href = eventPath(relatedEvent?.slug);
              return relatedEvent && href
                ? `<li><a href="${href}" class="link text-sm">${escapeHtml(relatedEvent.title)}</a></li>`
                : '';
            }).join('')}
          </ul>
        </section>
      `);
    }

    if (event.conflict_id) {
      parts.push(`
        <section class="card">
          <h2 class="text-xl font-semibold text-humanity-text mb-4">Related Conflict</h2>
          <p class="text-humanity-textMuted">This event is part of the <a href="/conflicts" class="link">${escapeHtml(event.conflict_id)}</a> conflict.</p>
        </section>
      `);
    }
    return parts.join('');
  }
  
  function formatDate(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }
  
  function formatDateTime(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    const date = new Date(dateStr);
    return date.toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  
  function formatRange(min: number | undefined, max: number | undefined, unit = '') {
    if (min !== undefined && max !== undefined) {
      if (min === max) return `${min.toLocaleString()} ${unit}`.trim();
      return `${min.toLocaleString()}–${max.toLocaleString()} ${unit}`.trim();
    }
    if (min !== undefined) return `≥${min.toLocaleString()} ${unit}`.trim();
    if (max !== undefined) return `≤${max.toLocaleString()} ${unit}`.trim();
    return '—';
  }
  
  async function initEventMap(event: PublishedEvent) {
    const maplibregl = await import('maplibre-gl');
    await import('maplibre-gl/dist/maplibre-gl.css');
    
    const map = new maplibregl.Map({
      container: 'event-map',
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://a.tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '© OpenStreetMap contributors'
          }
        },
        layers: [
          { id: 'background', type: 'background', paint: { 'background-color': '#050505' } },
          { id: 'osm', type: 'raster', source: 'osm' }
        ]
      },
      center: [event.longitude!, event.latitude!],
      zoom: 10,
      interactive: false
    });
    
    map.on('load', () => {
      new maplibregl.Marker({ color: '#ef4444' })
        .setLngLat([event.longitude!, event.latitude!])
        .addTo(map);
    });
  }
  
</script>
</BaseLayout>
