---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Live Events | HUMANITY" description="Browse all detected human events worldwide. Filter by type, country, date, and severity.">
  <div class="min-h-screen">
    <header class="border-b border-humanity-border bg-humanity-darker/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3">
              <svg class="w-8 h-8 text-humanity-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span class="text-2xl font-bold tracking-tight text-humanity-text">HUMANITY</span>
            </a>
            <span class="text-humanity-textMuted">/</span>
            <span class="text-humanity-text">Live Events</span>
          </div>
          <nav class="hidden md:flex items-center gap-6">
            <a href="/" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Home</a>
            <a href="/map" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Map</a>
            <a href="/events" class="text-humanity-accent font-medium text-sm">Live Events</a>
            <a href="/protests" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Protests</a>
            <a href="/conflicts" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Conflicts</a>
            <a href="/human-cost" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Human Cost</a>
            <a href="/countries" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Countries</a>
            <a href="/timelines" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Timelines</a>
            <a href="/methodology" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Methodology</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.7)]" aria-hidden="true"></span>
          <h1 class="text-3xl font-bold text-humanity-text mb-2">Live Events</h1>
        </div>
        <p class="text-humanity-textMuted">All detected human events worldwide. Data updated automatically.</p>
        <p id="events-refresh-status" class="mt-2 text-xs text-humanity-textMuted" aria-live="polite">Checking for new reports…</p>
      </div>

      <!-- Filters -->
      <div class="card mb-8">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-sm text-humanity-textMuted mb-1">Search events</label>
            <input type="text" id="search-input" placeholder="Search by title, location, country..." class="input" />
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Event Type</label>
            <select id="type-filter" class="input">
              <option value="">All Types</option>
              <option value="PROTEST">Protest</option>
              <option value="CONFLICT">Conflict</option>
              <option value="ATTACK">Attack</option>
              <option value="CASUALTY">Casualty</option>
              <option value="DISPLACEMENT">Displacement</option>
              <option value="DISASTER">Disaster</option>
              <option value="REPRESSION">Repression</option>
              <option value="HUMANITARIAN">Humanitarian</option>
              <option value="DIPLOMACY">Diplomacy</option>
              <option value="PEACE_PROCESS">Peace process</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Country</label>
            <select id="country-filter" class="input">
              <option value="">All Countries</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Severity</label>
            <select id="severity-filter" class="input">
              <option value="">All Severities</option>
              <option value="10">10 - Unprecedented</option>
              <option value="9">9 - Catastrophic</option>
              <option value="8">8 - Extreme</option>
              <option value="7">7 - Critical</option>
              <option value="6">6 - Severe</option>
              <option value="5">5 - Serious</option>
              <option value="4">4 - Significant</option>
              <option value="3">3 - Moderate</option>
              <option value="2">2 - Low</option>
              <option value="1">1 - Minimal</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-humanity-textMuted mb-1">Date Range</label>
            <select id="date-filter" class="input">
              <option value="">All Time</option>
              <option value="1">Last 24 hours</option>
              <option value="7">Last 7 days</option>
              <option value="30">Last 30 days</option>
              <option value="90">Last 90 days</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div id="events-container" class="space-y-4">
        <div class="card text-center py-12">
          <div class="animate-pulse-soft text-humanity-textMuted">Loading events...</div>
        </div>
      </div>

      <!-- Pagination -->
      <div id="pagination" class="flex items-center justify-center gap-2 mt-8"></div>
    </main>
  </div>

<script>
  import { escapeHtml, eventPath, parsePublishedEvents, requireElement, sitePath, type PublishedEvent } from '../lib/client-utils';

  let allEvents: PublishedEvent[] = [];
  let currentPage = 1;
  const pageSize = 20;

  document.addEventListener('DOMContentLoaded', async () => {
    const requestedType = new URLSearchParams(window.location.search).get('type');
    const typeFilter = requireElement('type-filter', 'select');
    if (requestedType && [...typeFilter.options].some(option => option.value === requestedType)) {
      typeFilter.value = requestedType;
    }
    await loadEvents();
    setupFilters();
    window.setInterval(loadEvents, 60_000);
  });

  async function loadEvents() {
    const container = requireElement('events-container', 'div');
    try {
      const response = await fetch(`${sitePath('data/events/all.json')}?updated=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Events feed request failed (${response.status})`);
      const events = parsePublishedEvents(await response.json());
      allEvents = events;
      populateCountryFilter();
      renderEvents();
      requireElement('events-refresh-status', 'p').textContent =
        `Checked ${new Date().toLocaleTimeString()} · refreshes every minute`;
    } catch (error) {
      console.error('Could not refresh published events:', error);
      requireElement('events-refresh-status', 'p').textContent =
        allEvents.length ? 'Could not refresh; showing the latest available reports.' : 'Live reports are temporarily unavailable.';
      if (!allEvents.length) {
        container.innerHTML = '<div class="card p-8 text-center text-humanity-textMuted">The live events feed is temporarily unavailable. Please try again shortly.</div>';
      }
    }
  }

  function populateCountryFilter() {
    const select = requireElement('country-filter', 'select');
    const selectedCountry = select.value;
    select.length = 1;
    const countries = [...new Set(allEvents.map(e => e.country_name).filter((country): country is string => Boolean(country)))].sort();
    countries.forEach(country => {
      const option = document.createElement('option');
      option.value = country;
      option.textContent = country;
      select.appendChild(option);
    });
    select.value = selectedCountry;
  }

  function setupFilters() {
    const filters = ['search-input', 'type-filter', 'country-filter', 'severity-filter', 'date-filter'];
    filters.forEach(id => {
      requireElement(id, id === 'search-input' ? 'input' : 'select').addEventListener('input', () => {
        currentPage = 1;
        renderEvents();
      });
    });
    requireElement('pagination', 'div').addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('button[data-page]');
      if (!button || button.disabled) return;
      changePage(Number(button.dataset.page));
    });
  }

  function getFilteredEvents() {
    const search = requireElement('search-input', 'input').value.toLowerCase();
    const type = requireElement('type-filter', 'select').value;
    const country = requireElement('country-filter', 'select').value;
    const severity = requireElement('severity-filter', 'select').value;
    const dateRange = requireElement('date-filter', 'select').value;

    return allEvents.filter(event => {
      if (search && !String(event.title || '').toLowerCase().includes(search) &&
          !String(event.city || '').toLowerCase().includes(search) &&
          !String(event.country_name || '').toLowerCase().includes(search)) {
        return false;
      }
      if (type && event.event_type !== type) return false;
      if (country && event.country_name !== country) return false;
      if (severity && (event.severity ?? 0) < parseInt(severity)) return false;
      if (dateRange) {
        const eventDate = new Date(event.start_time);
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - parseInt(dateRange));
        if (eventDate < cutoff) return false;
      }
      return true;
    }).sort((a, b) => new Date(b.start_time).getTime() - new Date(a.start_time).getTime());
  }

  function renderEvents() {
    const container = requireElement('events-container', 'div');
    const pagination = requireElement('pagination', 'div');
    const filtered = getFilteredEvents();
    
    const totalPages = Math.ceil(filtered.length / pageSize);
    currentPage = totalPages ? Math.min(currentPage, totalPages) : 1;
    const start = (currentPage - 1) * pageSize;
    const pageEvents = filtered.slice(start, start + pageSize);

    if (pageEvents.length === 0) {
      container.innerHTML = `
        <div class="card text-center py-12">
          <h3 class="text-lg font-medium text-humanity-text mb-2">No events found</h3>
          <p class="text-humanity-textMuted">Try adjusting your filters or search terms.</p>
        </div>
      `;
      pagination.innerHTML = '';
      return;
    }

    container.innerHTML = pageEvents.map(event => {
      const href = eventPath(event.slug);
      const eventTitle = href
        ? `<a href="${href}" class="hover:text-humanity-accent">${escapeHtml(event.title)}</a>`
        : escapeHtml(event.title);
      const eventType = String(event.event_type || 'EVENT');
      const eventTypeLabel = escapeHtml(getEventTypeLabel(eventType));
      const confidence = String(event.confidence || 'LOW');
      return `
        <article class="overflow-hidden rounded-2xl border border-humanity-border bg-humanity-card transition-colors hover:border-humanity-accent/40">
          <div class="grid md:grid-cols-[minmax(12rem,0.85fr)_1.5fr]">
            <div class="relative flex min-h-52 items-end overflow-hidden bg-gradient-to-br from-humanity-accent/20 via-humanity-darker to-humanity-card p-5">
              <div class="absolute inset-0 opacity-30" aria-hidden="true" style="background-image: radial-gradient(circle at 70% 25%, rgba(200,210,220,.32) 0 1px, transparent 2px), linear-gradient(135deg, transparent 45%, rgba(200,210,220,.12) 46%, transparent 47%); background-size: 26px 26px, 100% 100%;"></div>
              <span class="relative rounded-full border border-white/15 bg-black/30 px-3 py-1 text-xs font-medium text-white">${eventTypeLabel} · Illustrative category art</span>
            </div>
            <div class="min-w-0 p-5 sm:p-6">
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <span class="badge-${escapeHtml(eventType.toLowerCase())}">${eventTypeLabel}</span>
                <span class="badge-confidence-${escapeHtml(confidence.toLowerCase())}">${escapeHtml(event.confidence || 'Reported')}</span>
                <span class="text-xs text-humanity-textMuted">Severity ${Number.isFinite(event.severity) ? event.severity : '—'}/10</span>
              </div>
              <h2 class="text-xl font-semibold leading-snug text-humanity-text">${eventTitle}</h2>
              <p class="mt-2 text-sm leading-relaxed text-humanity-textMuted line-clamp-3">${escapeHtml(event.summary || 'Details are still emerging.')}</p>
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs text-humanity-textMuted">
                <span>${escapeHtml([event.city, event.country_name].filter(Boolean).join(', ') || 'Location unconfirmed')}</span>
                <span>${escapeHtml(formatDate(event.start_time))}</span>
                <span>${Number.isSafeInteger(event.sources?.length) ? event.sources?.length : 0} sources</span>
              </div>
              ${renderHumanImpact(event)}
            </div>
          </div>
        </article>
      `;
    }).join('');

    // Pagination
    if (totalPages > 1) {
      pagination.innerHTML = `
        <button data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} class="btn-secondary">Previous</button>
        <span class="px-4 text-humanity-textMuted">Page ${currentPage} of ${totalPages}</span>
        <button data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''} class="btn-secondary">Next</button>
      `;
    } else {
      pagination.innerHTML = '';
    }
  }

  function changePage(page: number) {
    currentPage = page;
    renderEvents();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderHumanImpact(event: PublishedEvent) {
    const impacts = event.human_impact || {};
    const parts = [];
    if (impacts.deaths) parts.push(`<span class="text-red-400">☠ ${escapeHtml(impacts.deaths)}</span>`);
    if (impacts.injuries) parts.push(`<span class="text-orange-400">🤕 ${escapeHtml(impacts.injuries)}</span>`);
    if (impacts.arrests) parts.push(`<span class="text-violet-400">🚔 ${escapeHtml(impacts.arrests)}</span>`);
    if (impacts.displaced) parts.push(`<span class="text-amber-400">🏃 ${escapeHtml(impacts.displaced)}</span>`);
    if (impacts.participants) parts.push(`<span class="text-blue-400">✊ ${escapeHtml(impacts.participants)}</span>`);
    if (parts.length === 0) return '';
    return `<div class="flex flex-wrap gap-3 mt-2">${parts.join('')}</div>`;
  }

  function getEventTypeLabel(type: string) {
    const labels: Record<string, string> = { PROTEST: 'Protest', CONFLICT: 'Conflict', ATTACK: 'Attack', CASUALTY: 'Casualty', DISPLACEMENT: 'Displacement', DISASTER: 'Disaster', REPRESSION: 'Repression', HUMANITARIAN: 'Humanitarian', DIPLOMACY: 'Diplomacy', PEACE_PROCESS: 'Peace process' };
    return labels[type] || String(type || 'Event');
  }

  function formatDate(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

</script>
</BaseLayout>