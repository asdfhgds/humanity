---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryImage from '../components/StoryImage.astro';
---

<BaseLayout title="Conflict & Security | HUMANITY" description="Browse published conflict-related event records with source and uncertainty context.">
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 grid items-center gap-6 border-b border-humanity-border pb-8 sm:grid-cols-[1fr_22rem]">
      <div><p class="eyebrow">Conflict reporting</p><h1 class="editorial-title mt-2 text-4xl font-bold">Conflict & security</h1><p class="mt-3 max-w-2xl text-humanity-textMuted">Published conflict-related event records, grouped by the project’s tracked conflict identifiers.</p><p class="mt-2 text-xs text-humanity-textMuted">Database event counts are not estimates of total conflict activity or human impact.</p></div>
      <StoryImage image="conflict" />
    </header>
    <p id="conflicts-status" class="mb-4 text-sm text-humanity-textMuted" aria-live="polite">Loading published conflict groups…</p>
    <div id="conflicts-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <p class="col-span-full border-y border-humanity-border py-8 text-humanity-textMuted">Retrieving published data…</p>
    </div>
    <button id="conflicts-retry" type="button" class="btn-secondary mt-5 hidden">Retry loading conflicts</button>
    <p class="mt-8 text-sm text-humanity-textMuted">Each count refers to published events in this database. <a href="/methodology" class="link">Read how the records are assessed.</a></p>
  </main>

  <script>
    import { escapeHtml, requireElement, sitePath } from '../lib/client-utils';

    interface ConflictRecord {
      name: string;
      status?: string;
      countries?: string;
      events?: number;
      since?: string;
    }

    function isConflictRecord(value: unknown): value is ConflictRecord {
      if (!value || typeof value !== 'object') return false;
      const record = value as Record<string, unknown>;
      return typeof record.name === 'string' &&
        (record.status === undefined || typeof record.status === 'string') &&
        (record.countries === undefined || typeof record.countries === 'string') &&
        (record.events === undefined || typeof record.events === 'number') &&
        (record.since === undefined || typeof record.since === 'string');
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadConflicts();
      requireElement('conflicts-retry', 'button').addEventListener('click', loadConflicts);
    });

    async function loadConflicts() {
      const status = requireElement('conflicts-status', 'p');
      const grid = requireElement('conflicts-grid', 'div');
      const retry = requireElement('conflicts-retry', 'button');
      retry.classList.add('hidden');
      status.textContent = 'Loading published conflict groups…';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 10_000);
      try {
        let response;
        try {
          response = await fetch(sitePath('data/conflicts/all.json'), { signal: controller.signal, cache: 'no-store' });
        } finally {
          window.clearTimeout(timeout);
        }
        if (!response.ok) throw new Error(`Conflict feed request failed (${response.status})`);
        const conflicts: unknown = await response.json();
        if (!Array.isArray(conflicts) || !conflicts.every(isConflictRecord)) throw new Error('Conflict feed has an invalid format');
        if (!conflicts.length) {
          grid.innerHTML = '<p class="col-span-full border-y border-humanity-border py-8 text-humanity-textMuted">No conflict groups are currently represented in the published event database.</p>';
          status.textContent = 'Published data checked successfully.';
          return;
        }
        grid.innerHTML = conflicts.map((conflict: ConflictRecord) => `
          <article class="border-t-2 border-humanity-accent py-5">
            <div class="flex items-start justify-between gap-3">
              <h2 class="editorial-title text-2xl font-semibold">${escapeHtml(conflict.name)}</h2>
              <span class="text-xs uppercase tracking-wide text-humanity-textMuted">${escapeHtml(conflict.status || 'Status unspecified')}</span>
            </div>
            <p class="mt-2 text-sm text-humanity-textMuted">${escapeHtml(conflict.countries || 'Country not specified')}</p>
            <p class="mt-5 font-serif text-3xl tabular-nums text-humanity-text">${typeof conflict.events === 'number' && Number.isSafeInteger(conflict.events) ? conflict.events.toLocaleString() : '—'}</p>
            <p class="text-xs text-humanity-textMuted">published event records · tracked since ${escapeHtml(conflict.since || 'date unavailable')}</p>
          </article>
        `).join('');
        status.textContent = `${conflicts.length} published conflict group${conflicts.length === 1 ? '' : 's'} · database snapshot`;
      } catch (error) {
        console.error('Could not load published conflict groups:', error);
        status.textContent = 'Conflict data is temporarily unavailable. No fallback estimates are shown.';
        grid.innerHTML = '';
        retry.classList.remove('hidden');
      }
    }
  </script>
</BaseLayout>
