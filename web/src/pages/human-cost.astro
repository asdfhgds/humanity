---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryImage from '../components/StoryImage.astro';
---

<BaseLayout title="Human Cost | HUMANITY" description="The human toll of conflicts, disasters, and crises worldwide. Reported deaths, injuries, displacement, and affected populations with full source transparency.">
  <div class="min-h-screen">
    <header class="border-b border-humanity-border bg-humanity-darker/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3">
              <svg class="w-8 h-8 text-humanity-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span class="text-2xl font-bold tracking-tight text-humanity-text">HUMANITY</span>
            </a>
            <span class="text-humanity-textMuted">/</span>
            <span class="text-humanity-text">Human Cost</span>
          </div>
          <nav class="hidden md:flex items-center gap-6">
            <a href="/" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Home</a>
            <a href="/map" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Map</a>
            <a href="/events" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Live Events</a>
            <a href="/protests" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Protests</a>
            <a href="/conflicts" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Conflicts</a>
            <a href="/human-cost" class="text-humanity-accent font-medium text-sm">Human Cost</a>
            <a href="/countries" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Countries</a>
            <a href="/timelines" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Timelines</a>
            <a href="/methodology" class="text-humanity-textMuted hover:text-humanity-text transition-colors text-sm font-medium">Methodology</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8 grid items-center gap-6 border-b border-humanity-border pb-8 sm:grid-cols-[1fr_22rem]">
        <div><p class="eyebrow">Human impact, with context</p><h1 class="editorial-title mt-2 text-4xl font-bold">Human cost</h1><p class="mt-3 text-humanity-textMuted">Reported impacts from published event records. Figures are database metrics, not comprehensive real-world totals.</p></div>
        <StoryImage image="humanitarian" />
      </div>
      <p id="human-cost-status" class="mb-4 text-sm text-humanity-textMuted" aria-live="polite">Loading published impact records…</p>
      <button id="human-cost-retry" type="button" class="btn-secondary mb-6 hidden">Retry loading impact data</button>

      <section class="mb-12 border-y border-humanity-border py-5">
        <h2 class="editorial-title text-2xl font-semibold">Why we do not show a global casualty scoreboard</h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-humanity-textMuted">Published reports may describe the same people, use different time periods, or revise earlier figures. Adding them together would imply a precision and completeness this database cannot establish. Individual reported ranges are shown with links to their event records instead.</p>
        <p class="mt-3 text-xs text-humanity-textMuted">Showing up to six latest published records per category. <a class="link" href="/events">Browse all published event records</a>.</p>
      </section>

      <!-- Conflict-Specific Human Cost -->
      <section class="mb-12">
        <h2 class="editorial-title text-2xl font-semibold">Conflict event records</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="conflict-costs">
          <!-- Will be populated by JS -->
        </div>
      </section>

      <!-- Disaster Human Cost -->
      <section class="mb-12">
        <h2 class="editorial-title text-2xl font-semibold">Disaster event records</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="disaster-costs">
          <!-- Will be populated by JS -->
        </div>
      </section>

      <!-- Methodology Note -->
      <section class="border-t border-humanity-border pt-6">
        <h2 class="text-xl font-semibold text-humanity-text mb-4 flex items-center gap-2">
          <span style="color: #f97316;">⚠️</span>
          How We Count
        </h2>
        <div class="max-w-3xl space-y-3 text-sm leading-relaxed text-humanity-textMuted">
          <p>Figures are displayed as ranges when the published event record contains a range. A missing value is not represented as zero.</p>
          <p>Open an event record to review its linked sources, claim-level evidence, reporting uncertainty and available dates.</p>
          <p>Only published records are included. Monitoring coverage is incomplete and changes as sources update reports.</p>
        </div>
      </section>
    </main>
  </div>

<script>
  import { escapeHtml, eventPath, requireElement, sitePath } from '../lib/client-utils';

  interface ImpactRange {
    min?: number | null;
    max?: number | null;
  }

  interface ImpactRecord {
    slug?: string;
    name: string;
    date?: string;
    city?: string;
    country?: string;
    deaths?: ImpactRange;
    injuries?: ImpactRange;
    displaced?: ImpactRange;
    confidence?: string;
    source_count?: number;
  }

  function isImpactRecord(value: unknown): value is ImpactRecord {
    if (!value || typeof value !== 'object') return false;
    const record = value as Record<string, unknown>;
    const isRange = (range: unknown) =>
      range === undefined ||
      (!!range && typeof range === 'object' &&
        ('min' in range && (range.min === null || typeof range.min === 'number') || !('min' in range)) &&
        ('max' in range && (range.max === null || typeof range.max === 'number') || !('max' in range)));
    return typeof record.name === 'string' &&
      (record.slug === undefined || typeof record.slug === 'string') &&
      (record.date === undefined || typeof record.date === 'string') &&
      (record.city === undefined || typeof record.city === 'string') &&
      (record.country === undefined || typeof record.country === 'string') &&
      isRange(record.deaths) && isRange(record.injuries) && isRange(record.displaced) &&
      (record.confidence === undefined || typeof record.confidence === 'string') &&
      (record.source_count === undefined || typeof record.source_count === 'number');
  }

  document.addEventListener('DOMContentLoaded', async () => {
    loadHumanCost();
    requireElement('human-cost-retry', 'button').addEventListener('click', loadHumanCost);
  });

  async function loadHumanCost() {
    const status = requireElement('human-cost-status', 'p');
    const retry = requireElement('human-cost-retry', 'button');
    retry.classList.add('hidden');
    status.textContent = 'Loading published impact records…';
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 10_000);
    try {
      let response;
      try {
        response = await fetch(sitePath('data/human-cost/global.json'), { signal: controller.signal, cache: 'no-store' });
      } finally {
        window.clearTimeout(timeout);
      }
      if (!response.ok) throw new Error(`Human-cost feed request failed (${response.status})`);
      const data: unknown = await response.json();
      if (
        !data ||
        typeof data !== 'object' ||
        !('conflicts' in data) ||
        !('disasters' in data) ||
        !Array.isArray(data.conflicts) ||
        !Array.isArray(data.disasters) ||
        !data.conflicts.every(isImpactRecord) ||
        !data.disasters.every(isImpactRecord) ||
        ('generated_at' in data && typeof data.generated_at !== 'string')
      ) throw new Error('Human-cost feed has an invalid format');
      const records = data as { conflicts: ImpactRecord[]; disasters: ImpactRecord[]; generated_at?: string };
      renderConflictCosts(records.conflicts);
      renderDisasterCosts(records.disasters);
      status.textContent = `Published impact records · generated ${records.generated_at ? new Date(records.generated_at).toLocaleString() : 'time unavailable'}. Values are event-level reports, not additive global totals.`;
    } catch (error) {
      console.error('Could not load published human-cost data:', error);
      status.textContent = 'Published impact records are temporarily unavailable. No substitute estimates are shown.';
      requireElement('conflict-costs', 'div').innerHTML = '';
      requireElement('disaster-costs', 'div').innerHTML = '';
      retry.classList.remove('hidden');
    }
  }

  function renderConflictCosts(conflicts: ImpactRecord[]) {
    const container = requireElement('conflict-costs', 'div');
    if (!conflicts || conflicts.length === 0) {
      container.innerHTML = '<div class="card p-6 text-humanity-textMuted">No conflict impact records are currently available in the published database.</div>';
      return;
    }
    container.innerHTML = conflicts.slice(0, 6).map(renderConflictCard).join('');
  }

  function renderDisasterCosts(disasters: ImpactRecord[]) {
    const container = requireElement('disaster-costs', 'div');
    if (!disasters || disasters.length === 0) {
      container.innerHTML = '<div class="card p-6 text-humanity-textMuted">No disaster impact records are currently available in the published database.</div>';
      return;
    }
    container.innerHTML = disasters.slice(0, 6).map(renderDisasterCard).join('');
  }

  function renderConflictCard(c: ImpactRecord) {
    return renderImpactRecord(c, 'border-red-500');
  }

  function renderDisasterCard(d: ImpactRecord) {
    return renderImpactRecord(d, 'border-sky-500');
  }

  function renderImpactRecord(record: ImpactRecord, border: string) {
    const metrics = [
      { label: 'Deaths reported', value: record.deaths },
      { label: 'Injuries reported', value: record.injuries },
      { label: 'People displaced', value: record.displaced },
    ].filter(
      (metric): metric is { label: string; value: ImpactRange } =>
        Boolean(metric.value && (metric.value.min != null || metric.value.max != null)),
    );
    const href = eventPath(record.slug);
    return `
      <article class="border-t-2 ${border} py-5">
        <h3 class="editorial-title text-xl font-semibold">${escapeHtml(record.name)}</h3>
        <p class="mt-1 text-xs text-humanity-textMuted">Event date: ${escapeHtml(formatDate(record.date))} · ${escapeHtml([record.city, record.country].filter(Boolean).join(', ') || 'Location not specified')}</p>
        ${metrics.length
          ? `<dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">${metrics.map(({ label, value }) => `<div><dt class="text-xs text-humanity-textMuted">${label}</dt><dd class="mt-1 font-serif text-xl tabular-nums text-humanity-text">${escapeHtml(formatRange(value.min, value.max))}</dd></div>`).join('')}</dl>`
          : '<p class="mt-4 text-sm text-humanity-textMuted">No impact value is reported in this event record.</p>'}
        <p class="mt-3 text-xs leading-relaxed text-humanity-textMuted">Event confidence: ${escapeHtml(record.confidence || 'not specified')} · ${typeof record.source_count === 'number' && Number.isSafeInteger(record.source_count) ? record.source_count : 'No'} linked source${record.source_count === 1 ? '' : 's'}. Claim-specific sourcing, reporting periods, scope and verification are available on the event record.</p>
        ${href ? `<a class="link mt-3 inline-block text-sm" href="${href}">Review sources and claims →</a>` : ''}
      </article>
    `;
  }

  function formatRange(min: number | null | undefined, max: number | null | undefined) {
    const hasMin = typeof min === 'number' && Number.isFinite(min);
    const hasMax = typeof max === 'number' && Number.isFinite(max);
    if (hasMin && hasMax) {
      if (min === max) return min.toLocaleString();
      return `${min.toLocaleString()}–${max.toLocaleString()}`;
    }
    if (hasMin) return `≥${min.toLocaleString()}`;
    if (hasMax) return `≤${max.toLocaleString()}`;
    return 'Not reported';
  }

  function formatDate(dateStr: string | undefined) {
    if (!dateStr) return 'Unknown';
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }
</script>
</BaseLayout>