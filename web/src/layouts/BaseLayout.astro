---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HUMANITY</title>
    <meta name="description" content={description || "A live global map and evidence-based database of protests, conflicts, humanitarian crises, disasters and other major human events."} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "A live global map and evidence-based database of protests, conflicts, humanitarian crises, disasters and other major human events."} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "A live global map and evidence-based database of protests, conflicts, humanitarian crises, disasters and other major human events."} />
  </head>
  <body class="bg-humanity-darker text-humanity-text min-h-screen font-sans antialiased">
    <slot />
    <script is:inline define:vars={{ basePath }}>
      // GitHub Pages serves this repository beneath /humanity. Keep root-relative
      // links and data requests working there while remaining a no-op at a domain root.
      const withBasePath = (value) =>
        basePath && typeof value === 'string' && value.startsWith('/') && !value.startsWith(`${basePath}/`)
          ? `${basePath}${value}`
          : value;

      const nativeFetch = window.fetch.bind(window);
      window.fetch = (input, init) =>
        nativeFetch(typeof input === 'string' ? withBasePath(input) : input, init);

      // Rewrite actual attributes. This supports normal clicks, keyboard
      // navigation, context menus, and links rendered later by client scripts.
      if (basePath) {
        const rewriteLinks = (root = document) => {
          root.querySelectorAll?.('a[href^="/"]').forEach((link) => {
            link.setAttribute('href', withBasePath(link.getAttribute('href')));
          });
        };
        rewriteLinks();
        new MutationObserver((mutations) => {
          mutations.forEach((mutation) => mutation.addedNodes.forEach((node) => {
            if (node instanceof Element) rewriteLinks(node);
          }));
        }).observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>
