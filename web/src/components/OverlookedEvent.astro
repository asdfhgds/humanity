---
interface Props {}
---
<div class="card border-amber-500/30 bg-amber-500/5" id="overlooked-event">
  <div class="flex min-w-0 items-start gap-4">
    <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center text-amber-500 bg-amber-500/10">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-amber-500 uppercase tracking-wider">Overlooked Event</span>
        <span class="text-xs text-humanity-textMuted">Automatically detected</span>
      </div>
      <h3 class="font-semibold text-humanity-text mb-1" id="overlooked-title">Loading overlooked event...</h3>
      <p class="text-sm text-humanity-textMuted" id="overlooked-summary">Finding significant events with low international coverage...</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-humanity-textMuted" id="overlooked-meta"></div>
    </div>
  </div>
</div>

<script>
  import { eventPath, requireElement, sitePath } from '../lib/client-utils';

  interface OverlookedRecord {
    slug?: string;
    title: string;
    summary?: string;
    city?: string;
    country?: string;
    event_type?: string;
    source_count?: number;
    importance_score?: number;
    coverage_ratio?: number;
  }

  function isOverlookedRecord(value: unknown): value is OverlookedRecord {
    if (!value || typeof value !== 'object') return false;
    const record = value as Record<string, unknown>;
    return typeof record.title === 'string' &&
      (record.slug === undefined || typeof record.slug === 'string') &&
      (record.summary === undefined || typeof record.summary === 'string') &&
      (record.city === undefined || typeof record.city === 'string') &&
      (record.country === undefined || typeof record.country === 'string') &&
      (record.event_type === undefined || typeof record.event_type === 'string') &&
      (record.source_count === undefined || typeof record.source_count === 'number') &&
      (record.importance_score === undefined || typeof record.importance_score === 'number') &&
      (record.coverage_ratio === undefined || typeof record.coverage_ratio === 'number');
  }

  document.addEventListener('DOMContentLoaded', () => {
    refreshOverlookedEvent();
    window.setInterval(refreshOverlookedEvent, 60_000);
  });

  async function refreshOverlookedEvent() {
    try {
      const response = await fetch(`${sitePath('data/overlooked/latest.json')}?updated=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Overlooked event request failed (${response.status})`);
      const record: unknown = await response.json();
      if (record !== null && !isOverlookedRecord(record)) throw new Error('Overlooked event data has an invalid format');
      renderEvent(record);
    } catch (error) {
      console.error('Could not refresh overlooked-event data:', error);
      const title = requireElement('overlooked-title', 'h3');
      if (!title.dataset.loaded) {
        title.textContent = 'Overlooked event data is unavailable';
        requireElement('overlooked-summary', 'p').textContent = 'Please check back when the latest reports are available.';
        requireElement('overlooked-meta', 'div').textContent = '';
      }
    }
  }
  
  function renderEvent(event: OverlookedRecord | null) {
    const titleEl = requireElement('overlooked-title', 'h3');
    const summaryEl = requireElement('overlooked-summary', 'p');
    const metaEl = requireElement('overlooked-meta', 'div');
    
    if (!event) {
      titleEl.textContent = 'No overlooked event detected today';
      summaryEl.textContent = 'All major events are receiving adequate coverage in monitored sources.';
      metaEl.replaceChildren();
      return;
    }
    
    const href = eventPath(event.slug);
    if (href) {
      const link = document.createElement('a');
      link.href = href;
      link.className = 'link hover:text-amber-400';
      link.textContent = event.title || 'Untitled event';
      titleEl.replaceChildren(link);
    } else {
      titleEl.textContent = event.title || 'Untitled event';
    }
    titleEl.dataset.loaded = 'true';
    summaryEl.textContent = event.summary || 'Significant event with limited international media coverage.';
    const details = [
      `📍 ${[event.city, event.country].filter(Boolean).join(', ') || 'Location unspecified'}`,
      getEventTypeLabel(event.event_type),
      `📰 ${Number.isSafeInteger(event.source_count) ? event.source_count : 0} sources`,
      `Importance: ${Number.isFinite(event.importance_score) ? Math.round(event.importance_score ?? 0) : 'not specified'}/100`,
      `Coverage ratio: ${Number.isFinite(event.coverage_ratio) ? Math.round((event.coverage_ratio ?? 0) * 100) : 'not specified'}%`,
    ];
    metaEl.replaceChildren(...details.map((text) => {
      const item = document.createElement('span');
      item.textContent = text;
      return item;
    }));
  }
  
  function getEventTypeLabel(type: string | undefined) {
    const labels: Record<string, string> = {
      PROTEST: 'Protest',
      CONFLICT: 'Conflict',
      ATTACK: 'Attack',
      CASUALTY: 'Casualty',
      DISPLACEMENT: 'Displacement',
      DISASTER: 'Disaster',
      REPRESSION: 'Repression',
      HUMANITARIAN: 'Humanitarian'
    };
    return (type && labels[type]) || type || 'Event';
  }
</script>