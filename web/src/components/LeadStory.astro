---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import StoryImage from './StoryImage.astro';
import { eventPath } from '../lib/client-utils';

interface EventRecord {
  slug?: string;
  title?: string;
  event_type?: string;
  country_name?: string;
  city?: string;
  start_time?: string;
  summary?: string;
  confidence_label?: string;
  confidence?: string;
  sources?: { publisher?: string }[];
  importance_score?: number;
}

let lead: EventRecord | null = null;
let feedAvailable = false;
try {
  const feedPath = resolve(process.cwd(), 'public', 'data', 'events', 'recent.json');
  const events = JSON.parse(await readFile(feedPath, 'utf8'));
  if (!Array.isArray(events)) throw new Error('The recent event feed must contain an array');
  feedAvailable = true;
  lead = events
    .filter((event): event is EventRecord => Boolean(event && typeof event.title === 'string'))
    .sort((a, b) => (Number(b.importance_score) || 0) - (Number(a.importance_score) || 0))[0] ?? null;
} catch (error) {
  if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) throw error;
}

const leadHref = lead ? eventPath(lead.slug) : null;
const location = lead ? [lead.city, lead.country_name].filter(Boolean).join(', ') : '';
const sourceCount = lead?.sources?.length ?? 0;
const image = lead?.event_type === 'PROTEST'
  ? 'protest'
  : lead?.event_type === 'DISASTER'
    ? 'disaster'
    : lead?.event_type === 'HUMANITARIAN'
      ? 'humanitarian'
      : lead?.event_type === 'DISPLACEMENT'
        ? 'displacement'
        : lead?.event_type === 'DIPLOMACY' || lead?.event_type === 'PEACE_PROCESS'
          ? 'diplomacy'
          : 'conflict';
---

<section aria-labelledby="lead-story-heading" class="lead-story">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div><p class="eyebrow">The report in focus</p><h2 class="editorial-title mt-2 text-3xl font-semibold sm:text-4xl">From the published record</h2></div>
    <a href="/events" class="link text-sm">Browse all reports →</a>
  </div>
  {lead ? (
    <article class="grid gap-6 border-y border-humanity-border py-6 lg:grid-cols-[1.12fr_.88fr] lg:items-center lg:gap-10 lg:py-8">
      <StoryImage image={image} class="lead-story__image" priority />
      <div class="min-w-0">
        <p class="eyebrow">Selected from published event records</p>
        <p class="mt-4 text-xs font-semibold uppercase tracking-[.12em] text-humanity-accent">{(lead.event_type || 'Event').replaceAll('_', ' ')}{location ? ` · ${location}` : ''}</p>
        <h3 id="lead-story-heading" class="editorial-title mt-3 text-3xl font-semibold leading-tight sm:text-4xl">{lead.title}</h3>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-humanity-textMuted">{lead.summary || 'The published record does not include a summary.'}</p>
        <p class="mt-5 border-t border-humanity-border pt-3 text-xs leading-relaxed text-humanity-textMuted">{lead.start_time ? `Event date: ${new Date(lead.start_time).toLocaleString('en', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })} UTC` : 'Event date not specified'} · {lead.confidence_label || lead.confidence || 'Reported'} · {sourceCount} linked sources</p>
        {leadHref && <a href={leadHref} class="link mt-5 inline-block">Read the event record →</a>}
      </div>
    </article>
  ) : (
    <div class="border-y border-humanity-border py-8">
      <h3 id="lead-story-heading" class="editorial-title text-2xl font-semibold">{feedAvailable ? 'No eligible lead report is available.' : 'Lead reporting is temporarily unavailable.'}</h3>
      <p class="mt-3 max-w-2xl text-humanity-textMuted">{feedAvailable ? 'The current published feed contains no eligible events to feature.' : 'The latest published event feed could not be found at build time.'} No story is invented to fill the space.</p>
      <a href="/events" class="link mt-5 inline-block">Browse published reports →</a>
    </div>
  )}
</section>

<style>
  .lead-story__image :global(.story-image__photo) { aspect-ratio: 4 / 3; }
</style>
