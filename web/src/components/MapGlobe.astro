---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['relative', className]}>
  <div id="map-globe"></div>
  <p id="map-globe-status" class="map-globe-status absolute bottom-3 left-3 z-10 max-w-[calc(100%-1.5rem)] bg-humanity-card/90 px-3 py-2 text-xs text-humanity-textMuted" aria-live="polite">Loading published map events…</p>
</div>

<script>
  import type { LngLat, Map as MapLibreMap, MapGeoJSONFeature, Popup } from 'maplibre-gl';
  import { eventPath, requireElement, sitePath } from '../lib/client-utils';
  
  document.addEventListener('DOMContentLoaded', () => {
    const container = requireElement('map-globe', 'div');
    const status = requireElement('map-globe-status', 'p');
    const initialize = () => {
      void loadMap(container, status).catch((error: unknown) => {
        console.error('Could not initialize the interactive map:', error);
        status.textContent = 'The interactive map is temporarily unavailable.';
      });
    };
    if (!('IntersectionObserver' in window)) {
      initialize();
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      initialize();
    }, { rootMargin: '250px' });
    observer.observe(container);
  });

  async function loadMap(container: HTMLDivElement, status: HTMLParagraphElement) {
    const maplibregl = await import('maplibre-gl');
    await import('maplibre-gl/dist/maplibre-gl.css');

    // MapLibre GL JS configuration
    const map = new maplibregl.Map({
      container,
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: [
              'https://a.tile.openstreetmap.org/{z}/{x}/{y}.png',
              'https://b.tile.openstreetmap.org/{z}/{x}/{y}.png',
              'https://c.tile.openstreetmap.org/{z}/{x}/{y}.png'
            ],
            tileSize: 256,
            attribution: '© OpenStreetMap contributors',
            maxzoom: 19
          }
        },
        layers: [
          {
            id: 'background',
            type: 'background',
            paint: {
              'background-color': '#f5f2eb'
            }
          },
          {
            id: 'osm',
            type: 'raster',
            source: 'osm',
            minzoom: 0,
            maxzoom: 19
          }
        ]
      },
      center: [0, 20],
      zoom: 1.2,
      renderWorldCopies: false
    });
    
    // Navigation controls
    map.addControl(new maplibregl.NavigationControl({
      visualizePitch: true
    }), 'top-right');
    
    // Load events data
    try {
      const response = await fetch(sitePath('data/map/events.geojson'), { cache: 'no-store' });
      if (!response.ok) throw new Error(`Map event request failed (${response.status})`);
      const geojson = await response.json();
      if (!geojson || geojson.type !== 'FeatureCollection' || !Array.isArray(geojson.features)) {
        throw new Error('Map event feed has an invalid format');
      }
      if (geojson.features.length === 0) {
        status.textContent = 'No published event locations are currently available.';
      } else {
        status.textContent = `${geojson.features.length.toLocaleString()} published event locations · refreshes with the site publication`;
      }
        
      map.on('load', () => {
          map.setProjection({ type: 'globe' });
          // Add source
          map.addSource('events', {
            type: 'geojson',
            data: geojson,
            cluster: true,
            clusterMaxZoom: 14,
            clusterRadius: 50
          });
          
          // Cluster circles
          map.addLayer({
            id: 'clusters',
            type: 'circle',
            source: 'events',
            filter: ['has', 'point_count'],
            paint: {
              'circle-color': [
                'step',
                ['get', 'point_count'],
                '#487b86',
                10, '#b47a43',
                50, '#9d4935',
                100, '#783727'
              ],
              'circle-radius': [
                'step',
                ['get', 'point_count'],
                16,
                10, 20,
                50, 28,
                100, 36
              ],
              'circle-stroke-width': 2,
              'circle-stroke-color': '#f5f2eb'
            }
          });
          
          // Cluster labels
          map.addLayer({
            id: 'cluster-count',
            type: 'symbol',
            source: 'events',
            filter: ['has', 'point_count'],
            layout: {
              'text-field': ['get', 'point_count_abbreviated'],
              'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Bold'],
              'text-size': 12
            },
            paint: {
              'text-color': '#ffffff'
            }
          });
          
          // Individual events
          map.addLayer({
            id: 'events-points',
            type: 'circle',
            source: 'events',
            filter: ['!', ['has', 'point_count']],
            paint: {
              'circle-color': [
                'match',
                ['get', 'event_type'],
                'PROTEST', '#487b86',
                'CONFLICT', '#9d4935',
                'ATTACK', '#783727',
                'CASUALTY', '#783727',
                'DISPLACEMENT', '#b47a43',
                'DISASTER', '#477d84',
                'REPRESSION', '#665b7d',
                'HUMANITARIAN', '#628264',
                '#66635d'
              ],
              'circle-radius': [
                'interpolate',
                ['linear'],
                ['get', 'severity'],
                1, 4,
                5, 8,
                10, 16
              ],
              'circle-stroke-width': 2,
              'circle-stroke-color': '#f5f2eb',
              'circle-opacity': 0.9
            }
          });
          
          // Hover effect
          map.on('mouseenter', 'events-points', (e) => {
            map.getCanvas().style.cursor = 'pointer';
            const feature = e.features?.[0];
            if (feature) {
              showEventPopup(maplibregl, map, feature, e.lngLat);
            }
          });
          
          map.on('mouseleave', 'events-points', () => {
            map.getCanvas().style.cursor = '';
            hideEventPopup();
          });
          
          map.on('mouseenter', 'clusters', () => {
            map.getCanvas().style.cursor = 'pointer';
          });
          
          map.on('mouseleave', 'clusters', () => {
            map.getCanvas().style.cursor = '';
          });
          
          // Click cluster to zoom
          map.on('click', 'clusters', (e) => {
            const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
            const cluster = features.find((feature) => typeof feature.properties?.cluster_id === 'number');
            if (!cluster) return;
            const geometry = cluster.geometry;
            if (geometry.type !== 'Point') return;
            const clusterId = cluster.properties?.cluster_id;
            const source = map.getSource('events');
            if (typeof clusterId !== 'number' || !(source instanceof maplibregl.GeoJSONSource)) return;
            source.getClusterExpansionZoom(clusterId).then((zoom) => {
              map.easeTo({
                center: [geometry.coordinates[0], geometry.coordinates[1]],
                zoom
              });
            }).catch((error: unknown) => {
              console.error('Could not expand the selected map cluster:', error);
            });
          });
          
          // Click event to navigate
          map.on('click', 'events-points', (e) => {
            const feature = e.features?.[0];
            const href = eventPath(feature?.properties?.slug);
            if (href) {
              window.location.href = href;
            }
          });
      });
    } catch (error) {
      console.error('Could not load published map events:', error);
      status.textContent = 'Published map events are temporarily unavailable.';
    }
    
  }
  
  let currentPopup: Popup | null = null;
  
  function showEventPopup(
    maplibregl: typeof import('maplibre-gl'),
    map: MapLibreMap,
    feature: MapGeoJSONFeature,
    lngLat: LngLat,
  ) {
    hideEventPopup();
    
    const props = feature.properties || {};
    const typeColors: Record<string, string> = {
      PROTEST: '#487b86',
      CONFLICT: '#9d4935',
      ATTACK: '#783727',
      CASUALTY: '#783727',
      DISPLACEMENT: '#b47a43',
      DISASTER: '#477d84',
      REPRESSION: '#665b7d',
      HUMANITARIAN: '#628264'
    };
    
    const color = typeColors[String(props.event_type || '')] || '#888888';
    const typeLabel = String(props.event_type || 'Event').replaceAll('_', ' ');
    const href = eventPath(props.slug);
    
    const popupContent = document.createElement('div');
    popupContent.className = 'maplibregl-popup-content';
    popupContent.style.cssText = `
      background: #fbf9f4;
      border: 1px solid ${color}40;
      border-radius: 2px;
      padding: 12px 16px;
      min-width: 200px;
      max-width: 280px;
      box-shadow: 0 10px 32px rgba(32,39,37,0.18);
    `;
    const header = document.createElement('div');
    header.style.cssText = 'display: flex; align-items: center; gap: 8px; margin-bottom: 8px;';
    const marker = document.createElement('span');
    marker.style.cssText = `display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: ${color};`;
    const label = document.createElement('strong');
    label.style.cssText = 'color: #202725; font-size: 14px;';
    label.textContent = typeLabel;
    header.append(marker, label);

    const title = document.createElement('h4');
    title.style.cssText = 'color: #202725; font-size: 14px; font-weight: 600; margin: 0 0 8px; line-height: 1.3;';
    title.textContent = String(props.title || 'Untitled event');

    const details = document.createElement('div');
    details.style.cssText = 'display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; color: #66635d;';
    const location = document.createElement('span');
    location.textContent = `${props.city || 'Unknown'}${props.country_name ? `, ${props.country_name}` : ''}`;
    const date = document.createElement('span');
    date.textContent = props.date || 'Date unavailable';
    details.append(location, date);

    popupContent.append(header, title, details);
    if (href) {
      const link = document.createElement('a');
      link.href = href;
      link.style.cssText = 'margin-top: 8px; display: inline-block; font-size: 12px; color: #9d4935; text-decoration: none;';
      link.textContent = 'View details →';
      popupContent.append(link);
    }
    
    currentPopup = new maplibregl.Popup({ 
      closeButton: false,
      closeOnClick: false,
      anchor: 'bottom'
    })
      .setLngLat(lngLat)
      .setDOMContent(popupContent)
      .addTo(map);
  }
  
  function hideEventPopup() {
    if (currentPopup) {
      currentPopup.remove();
      currentPopup = null;
    }
  }
</script>

<style>
  #map-globe {
    width: 100%;
    height: 100%;
  }

  .map-globe-status {
    pointer-events: none;
  }
  
  .maplibregl-popup-content {
    pointer-events: auto;
  }
  
  .maplibregl-popup-tip { border-top-color: #fbf9f4 !important; }
  .maplibregl-popup-content { color: #202725; }
</style>