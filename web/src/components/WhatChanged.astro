<div class="overflow-hidden rounded-2xl border border-humanity-border bg-humanity-card">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-humanity-border px-5 py-4 sm:px-6">
    <div>
      <h2 class="text-xl font-bold text-humanity-text sm:text-2xl">Developing Around the World</h2>
      <p class="mt-1 text-sm text-humanity-textMuted">Recent reports, checked continuously</p>
    </div>
    <a href="/events" class="link text-sm">Browse the live feed →</a>
  </div>
  <div id="what-changed" class="divide-y divide-humanity-border">
    <p class="p-5 text-sm text-humanity-textMuted">Loading recent reports…</p>
  </div>
  <p id="recent-refresh-status" class="border-t border-humanity-border px-5 py-3 text-xs text-humanity-textMuted" aria-live="polite">Checking for updates…</p>
</div>

<script>
  import { escapeHtml, eventPath, parsePublishedEvents, requireElement, sitePath, type PublishedEvent } from '../lib/client-utils';

  document.addEventListener('DOMContentLoaded', () => {
    refreshRecentReports();
    window.setInterval(refreshRecentReports, 60_000);
  });

  async function refreshRecentReports() {
    const container = requireElement('what-changed', 'div');
    const status = requireElement('recent-refresh-status', 'p');
    try {
      const response = await fetch(`${sitePath('data/events/recent.json')}?updated=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Recent reports request failed (${response.status})`);
      const events = parsePublishedEvents(await response.json());
      renderReports(container, events.slice(0, 5));
      container.dataset.loaded = 'true';
      container.dataset.updated = new Date().toLocaleTimeString();
      status.textContent = `Checked ${container.dataset.updated} · refreshes every minute`;
    } catch (error) {
      console.error('Could not refresh recent reports:', error);
      status.textContent = container.dataset.loaded
        ? 'Recent reports could not be refreshed; showing the latest data available.'
        : 'Current reports could not be loaded. Please try again later.';
      if (!container.dataset.loaded) {
        container.innerHTML = '<p class="p-5 text-sm text-humanity-textMuted">Recent reports are temporarily unavailable.</p>';
      }
    }
  }

  function renderReports(container: HTMLDivElement, events: PublishedEvent[]) {
    if (!events.length) {
      container.innerHTML = '<p class="p-5 text-sm text-humanity-textMuted">No recent published reports are available.</p>';
      return;
    }

    container.innerHTML = events.map(event => {
      const href = eventPath(event.slug);
      const title = href
        ? `<a href="${href}" class="link">${escapeHtml(event.title)}</a>`
        : escapeHtml(event.title);
      return `
        <article class="flex gap-4 p-4 sm:p-5">
          <div class="flex h-20 w-28 flex-shrink-0 items-end overflow-hidden rounded-lg bg-gradient-to-br from-humanity-accent/20 to-humanity-darker p-2 sm:h-24 sm:w-36">
            <span class="rounded bg-black/40 px-2 py-1 text-[.6rem] text-white">Illustrative category art</span>
          </div>
          <div class="min-w-0 flex-1">
            <div class="mb-1 flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-humanity-accent">${escapeHtml(getEventTypeLabel(event.event_type))}</span>
              <span class="text-xs text-humanity-textMuted">${escapeHtml(event.confidence_label || event.confidence || 'Reported')}</span>
            </div>
            <h3 class="font-semibold leading-snug text-humanity-text">${title}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-humanity-textMuted">${escapeHtml(event.summary || event.description || 'Details are still emerging.')}</p>
            <p class="mt-2 text-xs text-humanity-textMuted">${escapeHtml([event.city, event.country_name].filter(Boolean).join(', ') || 'Location unconfirmed')} · ${escapeHtml(event.start_time ? new Date(event.start_time).toLocaleString() : 'Time unconfirmed')} · ${Number.isSafeInteger(event.sources?.length) ? event.sources?.length : 0} sources</p>
          </div>
        </article>
      `;
    }).join('');
  }

  function getEventTypeLabel(type: string) {
    return String(type || 'EVENT').replaceAll('_', ' ').toLowerCase().replace(/\b\w/g, letter => letter.toUpperCase());
  }
</script>
