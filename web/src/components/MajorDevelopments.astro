<section aria-labelledby="latest-heading">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div><p class="eyebrow">Across the published record</p><h2 id="latest-heading" class="editorial-title mt-2 text-3xl font-semibold sm:text-4xl">Latest developments</h2><p class="mt-2 text-sm text-humanity-textMuted">Recent reports from monitored sources. Archive images below provide context; they do not depict the events described.</p></div>
    <a href="/events" class="link text-sm">All published reports →</a>
  </div>
  <div id="major-developments" class="latest-grid">
    <p class="col-span-full border-y border-humanity-border py-6 text-sm text-humanity-textMuted">Loading published reports…</p>
  </div>
  <p id="news-refresh-status" class="mt-4 text-xs text-humanity-textMuted" aria-live="polite">Checking for updates…</p>
</section>

<script>
  import { editorialImages, type EditorialImageKey } from '../data/editorial-images';
  import { escapeHtml, eventPath, sitePath } from '../lib/client-utils';

  interface PublishedEvent {
    slug?: string;
    title: string;
    event_type?: string;
    confidence_label?: string;
    confidence?: string;
    city?: string;
    country_name?: string;
    start_time?: string;
    summary?: string;
    description?: string;
    sources?: unknown[];
  }

  const NEWS_REFRESH_MS = 60_000;
  const imageByType: Record<string, EditorialImageKey> = {
    PROTEST: 'protest',
    CONFLICT: 'conflict',
    ATTACK: 'conflict',
    CASUALTY: 'conflict',
    DISPLACEMENT: 'displacement',
    DISASTER: 'disaster',
    REPRESSION: 'protest',
    HUMANITARIAN: 'humanitarian',
    DIPLOMACY: 'diplomacy',
    PEACE_PROCESS: 'diplomacy',
  };

  document.addEventListener('DOMContentLoaded', () => {
    refreshMajorDevelopments();
    window.setInterval(refreshMajorDevelopments, NEWS_REFRESH_MS);
  });

  async function refreshMajorDevelopments() {
    const container = document.getElementById('major-developments');
    const status = document.getElementById('news-refresh-status');
    if (!container || !status) return;

    try {
      const response = await fetch(`${sitePath('data/events/recent.json')}?updated=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`News feed request failed (${response.status})`);
      const data: unknown = await response.json();
      if (!Array.isArray(data) || !data.every(isPublishedEvent)) throw new Error('News feed has an invalid format');
      renderEvents(container, data.slice(0, 6));
      status.textContent = `Checked ${new Date().toLocaleTimeString()} · refreshes every minute`;
    } catch (error) {
      console.error('Could not refresh published news:', error);
      status.textContent = container.dataset.loaded
        ? 'News feed could not be refreshed; showing the latest data available.'
        : 'Current reports could not be loaded. Please try again later.';
      if (!container.dataset.loaded) {
        container.innerHTML = '<p class="col-span-full border-y border-humanity-border py-6 text-sm text-humanity-textMuted">Published reports are temporarily unavailable. Please try again shortly.</p>';
      }
    }
  }

  function isPublishedEvent(value: unknown): value is PublishedEvent {
    return Boolean(value && typeof value === 'object' && 'title' in value && typeof value.title === 'string');
  }

  function renderEvents(container: HTMLElement, events: PublishedEvent[]) {
    container.dataset.loaded = 'true';
    if (!events.length) {
      container.innerHTML = '<p class="col-span-full border-y border-humanity-border py-6 text-sm text-humanity-textMuted">No published reports are available yet.</p>';
      return;
    }

    container.innerHTML = events.map((event) => {
      const href = eventPath(event.slug);
      const title = href
        ? `<a href="${href}" class="hover:text-humanity-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-humanity-accent">${escapeHtml(event.title)}</a>`
        : escapeHtml(event.title);
      const type = String(event.event_type || 'EVENT');
      const typeLabel = escapeHtml(getEventTypeLabel(type));
      const image = editorialImages[imageByType[type] || 'conflict'];
      const sourceCount = Number.isSafeInteger(event.sources?.length) ? event.sources?.length : 0;
      const creator = 'creatorUrl' in image
        ? `<a href="${escapeHtml(image.creatorUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(image.creator)}</a>`
        : escapeHtml(image.creator);

      return `
        <article class="latest-story">
          <figure class="latest-story__figure">
            <img src="${sitePath(`images/editorial/${encodeURIComponent(image.file)}`)}" alt="${escapeHtml(image.alt)}" loading="lazy">
            <figcaption>${escapeHtml(image.caption)} Photo: ${creator} · <a href="${escapeHtml(image.commonsUrl)}" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a> · <a href="${escapeHtml(image.licenseUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(image.license)}</a></figcaption>
          </figure>
          <div class="latest-story__body">
            <p class="latest-story__type">${typeLabel} <span>·</span> ${escapeHtml(event.confidence_label || event.confidence || 'Reported')}</p>
            <h3>${title}</h3>
            <p class="latest-story__summary">${escapeHtml(event.summary || event.description || 'Details are still emerging.')}</p>
            <p class="latest-story__meta">${escapeHtml([event.city, event.country_name].filter(Boolean).join(', ') || 'Location unconfirmed')} · ${escapeHtml(event.start_time ? new Date(event.start_time).toLocaleDateString() : 'Date unconfirmed')} · ${sourceCount} linked sources</p>
          </div>
        </article>
      `;
    }).join('');
  }

  function getEventTypeLabel(type: string) {
    return String(type || 'EVENT').replaceAll('_', ' ').toLowerCase().replace(/\b\w/g, (letter) => letter.toUpperCase());
  }
</script>

<style>
  .latest-grid { display: grid; gap: 2rem; }
  .latest-story { min-width: 0; }
  .latest-story__figure { margin: 0; }
  .latest-story__figure img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #e9e4dc; }
  .latest-story__figure figcaption { padding-top: .4rem; color: #68645f; font: 400 .66rem/1.4 system-ui, sans-serif; }
  .latest-story__figure figcaption a { text-decoration: underline; text-underline-offset: 2px; }
  .latest-story__body { padding-top: .8rem; }
  .latest-story__type { color: #9d4935; font: 600 .68rem/1.4 system-ui, sans-serif; letter-spacing: .09em; text-transform: uppercase; }
  .latest-story__type span { color: #88837a; }
  .latest-story__body h3 { margin-top: .45rem; color: #202725; font: 600 1.35rem/1.2 Georgia, serif; text-wrap: balance; }
  .latest-story__summary { margin-top: .55rem; color: #66635d; font-size: .9rem; line-height: 1.55; }
  .latest-story__meta { margin-top: .8rem; border-top: 1px solid #d7d0c5; padding-top: .55rem; color: #66635d; font-size: .7rem; line-height: 1.5; }
  @media (min-width: 640px) { .latest-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; row-gap: 2.5rem; } }
  @media (min-width: 1024px) { .latest-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
