# HUMANITY - Required Environment Variables
# Copy this file to .env and fill in your values

# Gemini API (Primary LLM) - Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tavily API (Search) - Get from https://tavily.com - Optional
TAVILY_API_KEY=

# Cloudflare (Deployment) - Optional for later phases
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Pipeline Settings
MAX_ARTICLES_PER_RUN=1000
MAX_LLM_CALLS_PER_RUN=100
MAX_SEARCH_CALLS_PER_RUN=50
MIN_PUBLISH_SCORE=70
MIN_CONFIDENCE=0.6
ENABLE_TAVILY=false
ENABLE_AUTOPUBLISH=true